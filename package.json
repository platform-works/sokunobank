{
  "name": "sokuno-bank",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/inject-lp-site-tags.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lp:sync": "node scripts/sync-lp-factory.mjs",
    "verify:deploy": "node scripts/verify-clean-deploy.mjs",
    "cf:preview": "npm run lp:sync && npm run build && wrangler dev",
    "cf:deploy": "npm run lp:sync && npm run build && npm run check:dist && wrangler deploy",
    "test": "vitest run",
    "check:syntax": "node scripts/ci/check-inline-js-syntax.mjs",
    "check:ad-tags": "node scripts/ci/check-ad-tags.mjs",
    "check:dist": "npm run check:syntax && npm run check:ad-tags",
    "ads:tshirt:build": "esbuild scripts/yahoo-ads/build-original-tshirt.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-original-tshirt.mjs --log-level=warning && node node_modules/.cache/build-original-tshirt.mjs",
    "ads:goods:build": "esbuild scripts/yahoo-ads/build-original-goods.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-original-goods.mjs --log-level=warning && node node_modules/.cache/build-original-goods.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.2.0",
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.2",
    "wrangler": "^3.90.0"
  }
}
