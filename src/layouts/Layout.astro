---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "急ぎ発注・最短納期の比較サイト", noindex = false } = Astro.props;
const siteName = "SOKUNOBANK(即納バンク)";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/ogp.png", Astro.site);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.toString(),
  description: "法人の発注担当者向け「急ぎ発注・最短納期比較サイト」。DM発送代行・印刷・販促物などの即納サービスを、最短納期・料金・対応条件から比較する。",
  inLanguage: "ja",
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SOKUNOBANK運営事務局",
  url: Astro.site?.toString(),
  email: "dmsales29@gmail.com",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- 個人を特定できる情報(氏名・個人メール等)はメタデータに含めない -->

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <!--
      ValueCommerce LinkSwitch(2026-09-27導入)。全ページ共通のこのLayout.astroに1回だけ設置し、
      個別ページ・商品カード側では絶対に重複設置しない。Yahoo!ショッピングへの通常の商品URLを
      ブラウザ側で自動的にアフィリエイトリンクへ変換する仕組みのため、商品カード生成側では
      URLを一切加工せず、Yahoo!ショッピングの元の商品URLをそのまま出力すること
      (詳細はsrc/lib/commerce/handleProductsRequest.ts・ProductGrid.astroのコメント参照)。
      タグはValueCommerce管理画面から発行された形式のまま、一切改変せずFragmentでそのまま出力する
      (通常のAstroテンプレート構文で書くと、Astroがscoped CSS用のdata-astro-cid-*属性を
      要素に自動付与してしまい、タグを意図せず改変することになるため)。
    -->
    <Fragment
      set:html={`<script type="text/javascript" language="javascript">var vc_pid = "892714362";</script><script type="text/javascript" src="//aml.valuecommerce.com/vcdal.js" async></script>`}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header siteName={siteName} />
    <main id="main">
      <slot />
    </main>
    <Footer siteName={siteName} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    /* ベースカラー(2026-09-23:より明るく・グリーン寄りのトーンに調整) */
    --color-bg: #ffffff;
    --color-bg-soft: #f3faf6;
    --color-bg-soft-2: #edf8f1;
    --color-text: #10243e;
    --color-text-muted: #5b6b80;
    --color-border: #dceee4;

    /* ブランドアクセント(グリーン)。--color-accent/--color-accent-dark は
       白文字ボタン・リンクテキストにも使うため、コントラスト比を保った範囲で明るくしている。
       --color-accent-vivid はテキストを乗せない装飾(アイコン・グラデーション背景)専用 */
    --color-accent: #108a5f;
    --color-accent-dark: #05815b;
    --color-accent-vivid: #0c9a66;
    --color-accent-soft: #e3f7ec;
    --color-accent-contrast: #ffffff;

    /* 即納・緊急性の強調(オレンジ)。即納に関係する情報だけに使う */
    --color-urgent: #f59e0b;
    --color-urgent-text: #92400e;
    --color-urgent-soft: #fef3e2;

    /* 状態色 */
    --color-warn-bg: #fff8e6;
    --color-warn-border: #f2c94c;

    /* レイアウト */
    --container-width: 1200px;
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --shadow-sm: 0 1px 2px rgba(16, 36, 62, 0.06), 0 1px 1px rgba(16, 36, 62, 0.04);

    font-family: "Inter", "Noto Sans JP", "Hiragino Sans", -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
    font-size: 16px;
  }

  h1,
  h2,
  h3,
  h4 {
    line-height: 1.4;
    font-weight: 700;
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem);
    font-weight: 700;
  }

  h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
  }

  p {
    margin: 0 0 1rem;
  }

  a {
    color: var(--color-accent-dark);
  }

  a:hover {
    color: var(--color-accent);
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-text);
    color: #fff;
    padding: 0.6rem 1rem;
    z-index: 100;
    border-radius: 0 0 var(--radius-sm) 0;
  }
  .skip-link:focus {
    left: 0;
  }

  main {
    display: block;
  }

  /* ============ レイアウトユーティリティ ============ */
  .container {
    max-width: var(--container-width);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .section {
    padding-block: 2.75rem;
  }

  .section-tight {
    padding-block: 1.75rem;
  }

  .section-soft {
    background: var(--color-bg-soft);
  }

  .prose {
    max-width: 720px;
  }

  .prose p {
    color: var(--color-text);
  }

  .section-head {
    margin-bottom: 1.5rem;
  }

  .section-head .eyebrow {
    display: block;
    color: var(--color-accent-dark);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    margin-bottom: 0.4rem;
  }

  .section-head p {
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  /* ============ ボタン ============ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 44px;
    padding: 0 1.4rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    line-height: 1;
    white-space: nowrap;
  }

  .btn-lg {
    height: 48px;
    padding: 0 1.75rem;
    font-size: 1rem;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .btn-primary:hover {
    background: var(--color-accent-dark);
    color: var(--color-accent-contrast);
  }

  .btn-secondary {
    background: var(--color-bg);
    color: var(--color-text);
    border-color: var(--color-border);
  }
  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  .btn-disabled,
  .btn[aria-disabled="true"] {
    background: var(--color-bg-soft-2);
    color: var(--color-text-muted);
    border-color: var(--color-border);
    cursor: not-allowed;
  }

  /* ============ カード・チップ・バッジ ============ */
  .card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.4rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }
  .chip.is-disabled {
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
    cursor: default;
  }
  .chip.is-disabled:hover {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    vertical-align: middle;
  }

  .badge-urgent {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-urgent-text);
    background: var(--color-urgent-soft);
    border: 1px solid var(--color-urgent);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }

  .badge-soon {
    display: inline-flex;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg-soft-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  /* ============ パンくず ============ */
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-block: 1rem;
  }
  .breadcrumbs a {
    color: var(--color-text-muted);
  }
  .breadcrumbs a:hover {
    color: var(--color-accent-dark);
  }
  .breadcrumbs .sep {
    color: var(--color-border);
  }

  /* ============ 表(レスポンシブ:モバイルはカード化) ============ */
  table {
    border-collapse: collapse;
    width: 100%;
    background: var(--color-bg);
  }

  th,
  td {
    border: 1px solid var(--color-border);
    padding: 0.7rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  thead th {
    background: var(--color-bg-soft);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    table.responsive-table {
      border: none;
    }
    table.responsive-table thead {
      display: none;
    }
    table.responsive-table,
    table.responsive-table tbody,
    table.responsive-table tr,
    table.responsive-table th,
    table.responsive-table td {
      display: block;
      width: 100%;
    }
    table.responsive-table tr {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      margin-bottom: 1rem;
      padding: 0.85rem 1rem;
    }
    table.responsive-table th[scope="row"] {
      border: none;
      padding: 0 0 0.5rem;
      font-size: 1rem;
    }
    table.responsive-table td {
      border: none;
      padding: 0.4rem 0;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
    table.responsive-table td::before {
      content: attr(data-label);
      font-weight: 600;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      flex-shrink: 0;
    }
  }

  /* ============ フォーム部品 ============ */
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .field select,
  .field input[type="text"],
  .field input[type="date"] {
    height: 44px;
    padding: 0 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }
  .field select:disabled,
  .field input:disabled {
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    cursor: not-allowed;
  }
</style>
