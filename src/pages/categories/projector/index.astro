---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import FaqSection from "../../../components/FaqSection.astro";
import CommerceFilterPanel from "../../../components/commerce/CommerceFilterPanel.astro";
import ProductGrid from "../../../components/commerce/ProductGrid.astro";
import { projectorConfig as c } from "../../../lib/commerce/categories/projector.config";

// このページはprerender(静的)。商品一覧のみクライアント側でAPI(prerender=false)から取得するため、
// API取得に失敗してもH1・説明文・FAQ等の静的コンテンツは常にそのまま表示される。
---

<Layout title={c.pageTitle} description={c.metaDescription}>
  <Breadcrumbs
    items={[{ label: "ホーム", href: "/" }, { label: "カテゴリー一覧", href: "/categories/" }, { label: c.name }]}
  />

  <div class="container">
    <section class="hero">
      <h1>{c.h1}</h1>
      <p class="subheadline">{c.subheadline}</p>
      <p class="delivery-note">{c.deliveryNote}</p>
    </section>

    <CommerceFilterPanel
      slug={c.slug}
      priceBands={c.priceBands}
      reviewThresholds={c.reviewThresholds}
      sortOptions={c.sortOptions}
    />

    <p class="intro">{c.intro}</p>

    <ProductGrid slug={c.slug} apiPath={c.apiPath} />

    <Disclaimer text={c.deliveryNote} />

    {
      c.seoSections.map((section) => (
        <section class="seo-section">
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }

    <FaqSection items={c.faq} />
  </div>
</Layout>

<style>
  .hero {
    margin-top: 1.5rem;
  }
  .hero h1 {
    margin-bottom: 0.6rem;
  }
  .subheadline {
    font-size: 1.02rem;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }
  .delivery-note {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .intro {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 1rem;
  }
  .seo-section {
    margin-block: 2.25rem;
  }
</style>
