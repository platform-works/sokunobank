---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import FaqSection from "../../../components/FaqSection.astro";
import CommerceFilterPanel from "../../../components/commerce/CommerceFilterPanel.astro";
import ProductGrid from "../../../components/commerce/ProductGrid.astro";
import { projectorConfig as c } from "../../../lib/commerce/categories/projector.config";

// このページはprerender(静的)。商品一覧のみクライアント側でAPI(prerender=false)から取得するため、
// API取得に失敗してもH1・説明文・FAQ等の静的コンテンツは常にそのまま表示される。

// ValueCommerceの広告コードは規約上改変(書き換え・一部抜き出し・サイズ変更等)が禁止されているため、
// 元のタグを一切変更せず文字列としてそのまま埋め込む(set:html)。Astroのテンプレート構文で
// 書くと、scoped CSS用のdata-astro-cid-*属性が子要素(noscript内のa/img等)にまで
// 自動付与されてしまい、タグが変更されてしまうため、set:htmlで生のHTMLとして出力する。
const vcBannerHtml = `<script language="javascript" src="//ad.jp.ap.valuecommerce.com/servlet/jsbanner?sid=3782308&pid=892713218"></script><noscript><a href="//ck.jp.ap.valuecommerce.com/servlet/referral?sid=3782308&pid=892713218" rel="nofollow"><img src="//ad.jp.ap.valuecommerce.com/servlet/gifbanner?sid=3782308&pid=892713218" border="0"></a></noscript>`;

// スマートフォン専用のオーバーレイバナー(ValueCommerce指定)。指示では</body>直前への設置と
// なっているが、このバナーはprojectorページ専用のため共通Layout.astroは変更せず、
// このページ自身のコンテンツ末尾(Layoutのslot内、Footerの直前)に設置している。
const vcSmartphoneBannerHtml = `<script language="javascript" src="//ad.jp.ap.valuecommerce.com/servlet/smartphonebanner?sid=3782308&pid=892713452&position=overlay"></script>`;
---

<Layout title={c.pageTitle} description={c.metaDescription}>
  <Breadcrumbs
    items={[{ label: "ホーム", href: "/" }, { label: "カテゴリー一覧", href: "/categories/" }, { label: c.name }]}
  />

  <div class="container">
    <section class="hero">
      <div class="hero-main">
        <h1>{c.h1}</h1>
        <p class="subheadline">{c.subheadline}</p>
        <p class="delivery-note">{c.deliveryNote}</p>
      </div>

      <div class="hero-ad">
        <span class="hero-ad-label">PR</span>
        <div class="hero-ad-embed" set:html={vcBannerHtml} />
      </div>
    </section>

    <CommerceFilterPanel slug={c.slug} sortOptions={c.sortOptions} />

    <p class="intro">{c.intro}</p>

    <ProductGrid slug={c.slug} apiPath={c.apiPath} />

    <Disclaimer text={c.deliveryNote} />

    {
      c.seoSections.map((section) => (
        <section class="seo-section">
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }

    <FaqSection items={c.faq} />
  </div>

  <div set:html={vcSmartphoneBannerHtml} />
</Layout>

<style>
  .hero {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .hero-main {
    flex: 1 1 480px;
    min-width: 0;
  }
  .hero h1 {
    margin-bottom: 0.6rem;
  }
  .hero-ad {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem;
  }
  .hero-ad-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  /* モバイルはスマートフォン専用バナー(オーバーレイ)を別途表示するため、
     このPC向けバナーは重複表示を避けるためモバイル幅では非表示にする */
  @media (max-width: 720px) {
    .hero-ad {
      display: none;
    }
  }
  .subheadline {
    font-size: 1.02rem;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }
  .delivery-note {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .intro {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 1rem;
  }
  .seo-section {
    margin-block: 2.25rem;
  }
</style>
