---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import TopBannerAd from "../../../components/TopBannerAd.astro";
import Hero from "../../../components/Hero.astro";
import SummaryBox from "../../../components/SummaryBox.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import ComparisonFilter from "../../../components/ComparisonFilter.astro";
import ComparisonTable from "../../../components/ComparisonTable.astro";
import ProviderCard from "../../../components/ProviderCard.astro";
import ReaderPathways from "../../../components/ReaderPathways.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import FaqSection from "../../../components/FaqSection.astro";
import GuideCard from "../../../components/GuideCard.astro";
import { getPublishedCategories } from "../../../data/loadCategories";

export function getStaticPaths() {
  // 公開対象(status: "published")のカテゴリーのみルートを生成する。
  // カテゴリーを追加してもこのファイル自体の変更は不要。
  return getPublishedCategories().map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const tableId = `comparison-${category.slug}`;
const highlightField = category.comparisonFields[0];
const primaryProvider = category.providers.find((p) => p.isPrimary);

if (!category.lastVerifiedAt) {
  console.warn(
    `[categories/${category.slug}] lastVerifiedAt が未設定です。公開前に料金・納期情報を確認してください。`
  );
}
---

<Layout title={category.name} description={category.heroHeadline}>
  <Breadcrumbs
    items={[{ label: "ホーム", href: "/" }, { label: "カテゴリー一覧", href: "/categories/" }, { label: category.name }]}
  />

  <div class="container">
    {category.ads?.topBannerHtml && <TopBannerAd html={category.ads.topBannerHtml} />}

    <Hero
      headline={category.heroHeadline}
      subheadline={category.heroSubheadline}
      statHighlight={category.statHighlight}
    />

    {category.summary && <SummaryBox text={category.summary} />}

    <Disclaimer />

    {
      category.filterFields && category.filterFields.length > 0 && (
        <ComparisonFilter fields={category.filterFields} targetId={tableId} />
      )
    }

    <section>
      <h2>比較表</h2>
      <ComparisonTable id={tableId} fields={category.comparisonFields} providers={category.providers} />
    </section>

    <section>
      <h2>各社の詳細</h2>
      {category.providers.map((p) => <ProviderCard provider={p} highlightField={highlightField} />)}
    </section>

    {primaryProvider?.webOrderSteps && primaryProvider.webOrderSteps.length > 0 && (
      <ProcessSteps
        steps={primaryProvider.webOrderSteps}
        title={`${primaryProvider.name}でのWEB発注手順`}
      />
    )}

    {category.readerPathways && category.readerPathways.length > 0 && (
      <ReaderPathways title="選び方" pathways={category.readerPathways} />
    )}

    {category.processSteps && category.processSteps.length > 0 && (
      <ProcessSteps steps={category.processSteps} />
    )}

    {category.faq && category.faq.length > 0 && <FaqSection items={category.faq} />}

    {category.guides && category.guides.length > 0 && (
      <section>
        <h2>関連記事</h2>
        <div class="guide-grid">
          {category.guides.map((g) => (
            <GuideCard guide={g} />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  section {
    margin-block: 2.25rem;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.1rem;
  }
</style>
