---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqSection from "../../components/FaqSection.astro";

const publishedDate = "2026-09-27";
const updatedDate = "2026-09-28";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "会社案内を作るときに確認すべきポイント",
  description: "会社案内(パンフレット)を制作・印刷する際に確認しておきたい折り加工・サイズ・部数・納期の基本を、実際のネット印刷サービスの仕様例とあわせてまとめました。",
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: { "@type": "Organization", name: "SOKUNOBANK運営事務局" },
  publisher: { "@type": "Organization", name: "SOKUNOBANK運営事務局" },
};

const faqItems = [
  {
    question: "会社案内の折り方はどう選べばよいですか?",
    answer:
      "最もシンプルな「2つ折り」は商品紹介や会社案内・学校案内などに幅広く使われます。3つの面に分ける「巻き3つ折り」も会社案内でよく使われる形式です。カタログのように大きく開いて見せたい場合は「観音折り」が選ばれることもあります。",
  },
  {
    question: "会社案内のサイズはA4以外もありますか?",
    answer:
      "A4仕上がりが最も一般的ですが、A4 1/3仕上がり(3つ折り時の1面サイズ)、A5、B5、A6、B6など複数のサイズに対応しているネット印刷サービスがあります。配布シーン(名刺と一緒に渡す、封筒に入れて郵送する等)に合わせて選びます。",
  },
  {
    question: "デザインが手元にない場合はどうすればよいですか?",
    answer:
      "無料のオンラインデザインテンプレートを提供しているネット印刷サービスもあり、Web上でテンプレートを選んで文字・写真を差し替えるだけで作成できます。すでにデザインデータがある場合は、データ入稿のみで印刷・製本を依頼することで納期を短縮できます。",
  },
];
---

<Layout
  title="会社案内を作るときに確認すべきポイント"
  description="会社案内(パンフレット)を制作・印刷する際に確認しておきたい折り加工・サイズ・部数・納期の基本を、実際のネット印刷サービスの仕様例とあわせてまとめました。"
>
  <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "カテゴリー一覧", href: "/categories/" }, { label: "会社案内" }]} />

  <div class="container section-tight prose">
    <h1>会社案内を作るときに確認すべきポイント</h1>

    <p>
      会社案内は、内容の構成(デザイン)と印刷(折り加工・部数・用紙)の両方を決める必要があり、
      チラシや名刺に比べて準備期間が長くなりやすい制作物です。
      発注前に以下のポイントを整理しておくと、比較・発注がスムーズになります。
    </p>

    <h2>確認しておきたいポイント</h2>
    <ul>
      <li>
        <strong>折り加工</strong>: 「2つ折り」が最もシンプルでベーシックな形式で、会社案内・学校案内等に幅広く使われます。
        3つの等分面に分ける「巻き3つ折り」、Z字状に折る「外3つ折り」、扉のように開く「観音折り」など複数の折り方があり、
        情報量や見せ方に応じて選びます。
      </li>
      <li>
        <strong>ページ数・形式</strong>: 三つ折りリーフレットのような1枚もの(折りパンフレット)か、
        複数ページを綴じる冊子かで制作期間・費用が大きく変わります。
      </li>
      <li>
        <strong>サイズ</strong>: A4仕上がりが一般的ですが、A4 1/3仕上がり・A5・B5・A6・B6等の選択肢があるサービスもあります。
      </li>
      <li><strong>デザインの有無</strong>: 既存のテンプレートを使うか、デザインから依頼するかで納期が変わります。</li>
      <li><strong>部数</strong>: 展示会・営業用など用途に応じて必要部数を見積もります。</li>
      <li><strong>納期</strong>: デザイン確定から印刷・製本までの工程を踏まえ、余裕を持ったスケジュールで進める必要があります。</li>
    </ul>

    <h2>実際のネット印刷サービスでの仕様例</h2>
    <p>
      国内大手のネット印刷サービスの一例として、ラクスルの折りパンフレット印刷では、最短出荷1営業日、
      2つ折りパンフレット(A4仕上がり)の100部が5,000円台〜、巻き3つ折りが2,300円台〜という価格帯が
      案内されています(2026年9月確認時点、税込)。7種類の折り加工と6種類のサイズから選べ、
      無料のオンラインデザインテンプレートも用意されています。価格・仕様は変動するため、発注前に必ず公式サイトで最新情報をご確認ください。
    </p>

    <h2>急ぎで対応したい場合</h2>
    <p>
      デザインがすでに手元にある(社内で作成済み・既存データがある)場合は、
      印刷・製本のみを発注することで納期を短縮できることがあります。発注前に印刷会社へ
      「デザインデータ入稿のみ」で対応可能か確認するとよいでしょう。
    </p>

    <FaqSection items={faqItems} />

    <p><a href="/categories/">カテゴリー一覧に戻る →</a></p>
  </div>
</Layout>
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
