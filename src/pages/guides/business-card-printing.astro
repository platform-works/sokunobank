---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqSection from "../../components/FaqSection.astro";

// Amazonアソシエイト用の検索リンクを組み立てるヘルパー。
// PA-APIは使わず検索結果ページへのリンクのみとし、在庫・価格・配達日はAmazon側の表示に委ねる。
const amazonTag = "sokunobank-22";
function amazonSearch(keyword: string) {
  return `https://www.amazon.co.jp/s?k=${encodeURIComponent(keyword)}&tag=${amazonTag}`;
}

const publishedDate = "2026-09-27";
const updatedDate = "2026-10-03";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "名刺印刷を選ぶときに確認すべきポイント",
  description: "名刺印刷を発注・自作する際に確認しておきたい用紙・サイズ・部数・納期の基本を、実際のネット印刷サービスの仕様例とあわせてまとめました。",
  datePublished: publishedDate,
  dateModified: updatedDate,
  author: { "@type": "Organization", name: "SOKUNOBANK運営事務局" },
  publisher: { "@type": "Organization", name: "SOKUNOBANK運営事務局" },
};

const faqItems = [
  {
    question: "名刺のサイズは1種類しかありませんか?",
    answer:
      "日本国内で一般的な「通常サイズ」(91×55mm)のほか、欧米で使われる「欧米サイズ」(89×51mm)、一回り小さい「小型サイズ」(85×49mm)、「正方形サイズ」(55×55mm)、店舗情報等を載せられる「二つ折りサイズ」など複数のサイズが用意されているネット印刷サービスが多くあります。海外取引が多い場合は欧米サイズも選択肢になります。",
  },
  {
    question: "急な入社・異動で名刺が必要な場合、最短でどれくらいで届きますか?",
    answer:
      "サービスによりますが、通常サイズ・定番の用紙であれば最短翌日出荷に対応しているネット印刷会社があります。ただし入稿データの確定時刻や配送先地域によって実際の到着日は変わるため、発注前に最新の締切時刻を確認してください。",
  },
  {
    question: "用紙はどう選べばよいですか?",
    answer:
      "コスト重視ならマット紙やケント紙などの定番用紙、上質な印象を重視するなら高級紙(厚みのある紙や凹凸のある紙)、特別感を出したい場合は箔押し加工付きの名刺、という選び方が一般的です。",
  },
];
---

<Layout
  title="名刺印刷を選ぶときに確認すべきポイント"
  description="名刺印刷を発注・自作する際に確認しておきたい用紙・サイズ・部数・納期の基本を、実際のネット印刷サービスの仕様例とあわせてまとめました。"
>
  <Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "カテゴリー一覧", href: "/categories/" }, { label: "名刺印刷" }]} />

  <div class="container section-tight prose">
    <h1>名刺印刷を選ぶときに確認すべきポイント</h1>

    <p>
      名刺印刷は、サイズ・用紙の質感・カラー印刷の有無・部数の組み合わせで単価や納期が変わります。
      発注前に以下のポイントを整理しておくと、比較・発注がスムーズになります。
    </p>

    <h2>確認しておきたいポイント</h2>
    <ul>
      <li>
        <strong>サイズ</strong>: 日本で最も一般的なのは「通常サイズ」(91×55mm)です。
        このほか「欧米サイズ」(89×51mm、海外取引向け)、「小型サイズ」(85×49mm)、「正方形サイズ」(55×55mm)、
        店舗情報等を載せられる「二つ折りサイズ」など複数のサイズを用意しているサービスが多くあります。
      </li>
      <li>
        <strong>用紙の質感</strong>: マット・光沢(アートポスト)・ケント紙・上質紙といった定番用紙のほか、
        紙の白さや凹凸を活かした高級紙(厚み135kg〜225kg程度)も選べます。特別感を出したい場合は箔押し加工付きの名刺も選択肢です。
      </li>
      <li><strong>片面/両面カラー</strong>: 裏面に会社ロゴや地図・SNSアカウント等を入れる場合は両面印刷が必要です。</li>
      <li><strong>部数</strong>: 100枚単位での発注が一般的で、部数が多いほど1枚あたりの単価は下がる傾向があります。</li>
      <li>
        <strong>納期</strong>: 特急便対応の有無、入稿締切時刻を事前に確認してください。急な入社・異動対応では特に重要です。
      </li>
    </ul>

    <h2>実際のネット印刷サービスでの仕様例</h2>
    <p>
      国内大手のネット印刷サービスの一例として、ラクスルの名刺印刷では、通常サイズ・マット紙・両面カラーの100部が
      500円前後〜、最短翌日出荷という案内がされています(2026年9月確認時点、税込)。
      サイズは計5種類、用紙は13種類前後から選べます。
      価格・仕様は変動するため、発注前に必ず公式サイトで最新情報をご確認ください。
    </p>

    <h2>本当に急ぎのときは自社で印刷する</h2>
    <p>
      本当に急ぎで、少部数であれば、印刷会社に発注して届くのを待つよりも、自宅・オフィスのプリンターや複合機で
      自分で印刷するほうが最短で用意できる場合があります。データさえできればその場で印刷でき、
      入稿の締切時刻や配送日を待つ必要がないためです。
    </p>
    <p>
      ただし、名刺用紙の切り離し(カット済みの用紙を使う場合を除く)、印刷位置のずれ、紙質や色味といった仕上がりは、
      印刷会社への発注とは異なります。取引先に渡す名刺かどうかなど、使う場面に応じて使い分けてください。
    </p>
    <p>
      自社で使えるプリンター・複合機がない、または名刺用紙の印刷に対応していない場合は、
      お届け先を選ぶだけで、最短翌日に届く対象の商品から探せます。
    </p>
    <p>
      <a href="/categories/printer/">最短翌日に届くプリンター・複合機を比較する →</a>
    </p>
    <p>
      名刺用の用紙は、以下のAmazonのリンクから探せます(アソシエイトリンクを含みます)。
    </p>
    <p>
      <a href={amazonSearch("名刺用紙 インクジェット")} target="_blank" rel="sponsored noopener">
        名刺用紙をAmazonで探す →
      </a>
    </p>

    <FaqSection items={faqItems} />

    <p><a href="/categories/">カテゴリー一覧に戻る →</a></p>
  </div>
</Layout>
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
