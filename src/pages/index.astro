---
import Layout from "../layouts/Layout.astro";
import SearchHero from "../components/SearchHero.astro";
import UptPromoBanner from "../components/UptPromoBanner.astro";
import CategoryCard from "../components/CategoryCard.astro";
import GuideCard from "../components/GuideCard.astro";
import { getPublishedCategories } from "../data/loadCategories";
import {
  popularKeywords,
  departmentFinder,
  commerceCategories,
  upcomingCategories,
  concernFinder,
} from "../data/site-nav";

// サービス選びの確認ガイド(affiliate-lp-factory で公開済みのLP)。`npm run lp:sync` が生成するデータで、無ければ何も表示しない。
// 未公開のLPにはリンクしない。公開済みが0本の間はセクション自体を出さない。
type GuideLp = { lpId: string; path: string; title: string; description: string };
type GuideGenre = { slug: string; name: string; lps: GuideLp[] };
const guideModules = import.meta.glob("../data/generated/lp-guide.json", { eager: true }) as Record<string, { default?: { genres?: GuideGenre[] } }>;
const guideGenres: GuideGenre[] = Object.values(guideModules)[0]?.default?.genres ?? [];

const categories = getPublishedCategories();

function primaryProvider(category: (typeof categories)[number]) {
  return category.providers.find((p) => p.isPrimary) ?? category.providers[0];
}
function speedKey(category: (typeof categories)[number]) {
  return category.comparisonFields[0]?.key;
}
---

<Layout
  title="その悩み、即解決へ。｜仕事・暮らし・お金の悩みを素早く解決｜SOKUNOBANK(即納バンク)"
  description="仕事も、暮らしも、お金のことも。商品・サービスの条件や注意点を整理し、納得できる選択をサポートする情報プラットフォーム「SOKUNOBANK(即納バンク)」"
>
  <!-- ============================================ -->
  <!-- ① ファーストビュー - 新コンセプト -->
  <!-- ============================================ -->
  <section class="hero-new">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">その悩み、即解決へ。</h1>
        <p class="hero-subtitle">仕事も、暮らしも、お金のことも。あなたの悩みに合った解決策を、すばやく見つける。</p>
        <p class="hero-description">商品・サービスの条件や注意点を整理し、納得できる選択をサポートします。</p>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ② 何にお困りですか？ - 悩み別ナビゲーション -->
  <!-- ============================================ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <h2>何にお困りですか？</h2>
      </div>
      <div class="concern-grid">
        {
          concernFinder.map((concern) => (
            <div class="concern-card card">
              <h3>{concern.label}</h3>
              <p class="concern-description">{concern.description}</p>
              {concern.href ? (
                <a href={concern.href} class="concern-link">
                  詳しく見る →
                </a>
              ) : (
                <span class="concern-link is-disabled">準備中</span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ③ サービス選びの確認ガイド -->
  <!-- ============================================ -->
  {
    guideGenres.length > 0 && (
      <section class="section" id="service-guides">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">SERVICE GUIDE</span>
            <h2>サービス選びの確認ガイド</h2>
            <p>お金・美容・健康・結婚など、悩み別にサービス比較ガイドを提供</p>
          </div>
          <div class="guide-genres">
            {guideGenres.map((genre) => (
              <div class="genre-section">
                <h3>{genre.name}</h3>
                <div class="lp-cards">
                  {genre.lps.map((lp) => (
                    <div class="lp-card card">
                      <p class="lp-title">{lp.title}</p>
                      <p class="lp-description">{lp.description}</p>
                      <a href={lp.path} class="lp-link">
                        ガイドを見る →
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============================================ -->
  <!-- ④ 急ぎの商品・発注先を探す -->
  <!-- ============================================ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">PRODUCTS & SERVICES</span>
        <h2>急ぎの商品・発注先を探す</h2>
        <p>DM・印刷・発電機・オフィス用品など、最短納期の商品・サービスを比較</p>
      </div>
      <div class="category-grid">
        {
          categories.map((c) => {
            const provider = primaryProvider(c);
            const sKey = speedKey(c);
            return (
              <CategoryCard
                name={c.name}
                href={`/categories/${c.slug}/`}
                speedValue={sKey ? (provider?.values[sKey] as string) : undefined}
                minQuantityValue={provider?.values["minQuantity"] as string | undefined}
                providerCount={c.providers.length}
              />
            );
          })
        }
        {
          commerceCategories.map((cc) => (
            <CategoryCard
              name={cc.name}
              href={cc.href}
              speedLabel={cc.speedLabel}
              speedValue={cc.speedValue}
            />
          ))
        }
        {
          upcomingCategories
            .slice(0, 5)
            .map((u) => <CategoryCard name={u.name} href={u.href} ctaLabel={u.href ? "読む →" : undefined} />)
        }
      </div>
      <p class="see-all">
        <a href="/categories/">すべてのカテゴリーを見る →</a>
      </p>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ⑤ オリジナルTシャツ・グッズ（UP-T） -->
  <!-- ============================================ -->
  <UptPromoBanner />

  <!-- ============================================ -->
  <!-- ⑥ 困ったときの確認ガイド -->
  <!-- ============================================ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">QUICK GUIDE</span>
        <h2>困ったときの確認ガイド</h2>
      </div>
      <div class="guide-grid">
        <GuideCard
          guide={{
            title: "新しいNISAの仕組み",
            description: "口座選びのポイント・手数料・取扱商品",
            href: "/lp/affiliate/securities/nisa/",
          }}
        />
        <GuideCard
          guide={{
            title: "今日中に発電機を手配する",
            description: "最短配送と注意点",
            href: "/guides/urgent-handle-generator-today/",
          }}
        />
        <GuideCard
          guide={{
            title: "会議を明日開く時に必要な機器",
            description: "プロジェクター・モニター・チェア",
            href: "/guides/urgent-meeting-equipment/",
          }}
        />
        <GuideCard
          guide={{
            title: "ダイレクトメール発送のポイント",
            description: "スピード優先プランと料金比較",
            href: "/categories/dm/",
          }}
        />
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ⑦ サイト紹介・運営情報 -->
  <!-- ============================================ -->
  <section class="section section-soft">
    <div class="container">
      <div class="site-intro card">
        <h2>SOKUNOBANK(即納バンク)について</h2>
        <p>
          SOKUNOBANK(即納バンク)は、商品やサービスを選ぶための条件・費用・注意点を整理し、悩みを解決するための判断材料を提供する情報サイトです。
        </p>
        <p>
          「仕事の急な対応」「暮らしの悩み」「お金の選択肢」など、様々な場面で必要な情報を、最短で見つけられるプラットフォームを目指します。
        </p>
        <p class="disclaimer">
          <strong>※重要:</strong>
          本サイトで提供する情報は、商品・サービス選びの判断材料です。成果や効果を保証するものではありません。ご利用は自己責任でお願いします。
        </p>
        <div class="footer-links">
          <a href="/privacy/">プライバシーポリシー</a> |
          <a href="/about/">運営者情報</a> |
          <a href="/advertising/">広告掲載方針</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* ファーストビュー - 新コンセプト */
  .hero-new {
    background: linear-gradient(135deg, var(--color-bg-soft) 0%, var(--color-bg) 100%);
    padding: 4rem 1rem;
    text-align: center;
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .hero-description {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* 何にお困りですか？ */
  .concern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .concern-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
  }

  .concern-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .concern-description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    flex-grow: 1;
    margin-bottom: 1rem;
  }

  .concern-link {
    font-size: 0.95rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .concern-link:hover {
    text-decoration: underline;
  }

  .concern-link.is-disabled {
    color: var(--color-text-muted);
    cursor: default;
  }

  /* サービス選びの確認ガイド */
  .guide-genres {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .genre-section {
    border-top: 2px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .genre-section h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .lp-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .lp-card {
    padding: 1rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .lp-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .lp-description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .lp-link {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .lp-link:hover {
    text-decoration: underline;
  }

  /* サイト紹介 */
  .site-intro {
    padding: 2rem;
    text-align: center;
  }

  .site-intro h2 {
    margin-bottom: 1.5rem;
  }

  .site-intro p {
    margin-bottom: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .disclaimer {
    background: var(--color-bg-soft);
    padding: 1rem;
    border-left: 4px solid var(--color-urgent);
    margin: 1.5rem 0;
    text-align: left;
  }

  .footer-links {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  /* レスポンシブ */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .concern-grid {
      grid-template-columns: 1fr;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
