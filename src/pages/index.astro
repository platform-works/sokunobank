---
import Layout from "../layouts/Layout.astro";
import SearchHero from "../components/SearchHero.astro";
import UptPromoBanner from "../components/UptPromoBanner.astro";
import CategoryCard from "../components/CategoryCard.astro";
import GuideCard from "../components/GuideCard.astro";
import { getPublishedCategories } from "../data/loadCategories";
import {
  popularKeywords,
  departmentFinder,
  commerceCategories,
  upcomingCategories,
  concernFinder,
} from "../data/site-nav";

// サービス選びの確認ガイド(affiliate-lp-factory で公開済みのLP)。`npm run lp:sync` が生成するデータで、無ければ何も表示しない。
// 未公開のLPにはリンクしない。公開済みが0本の間はセクション自体を出さない。
type GuideLp = { lpId: string; path: string; title: string; description: string };
type GuideGenre = { slug: string; name: string; lps: GuideLp[] };
const guideModules = import.meta.glob("../data/generated/lp-guide.json", { eager: true }) as Record<string, { default?: { genres?: GuideGenre[] } }>;
const guideGenres: GuideGenre[] = Object.values(guideModules)[0]?.default?.genres ?? [];

const categories = getPublishedCategories();

function primaryProvider(category: (typeof categories)[number]) {
  return category.providers.find((p) => p.isPrimary) ?? category.providers[0];
}
function speedKey(category: (typeof categories)[number]) {
  return category.comparisonFields[0]?.key;
}
---

<Layout
  title="その悩み、即解決へ。｜仕事・暮らし・お金の悩みを素早く解決｜SOKUNOBANK(即納バンク)"
  description="仕事も、暮らしも、お金のことも。商品・サービスの条件や注意点を整理し、納得できる選択をサポートする情報プラットフォーム「SOKUNOBANK(即納バンク)」"
>
  <!-- ============================================ -->
  <!-- ① ファーストビュー - 新コンセプト -->
  <!-- ============================================ -->
  <section class="hero-new">
    <div class="hero-container">
      <div class="hero-content">
        <h1 class="hero-title">その悩み、即解決へ。</h1>
        <p class="hero-subtitle">仕事も、暮らしも、お金のことも。条件や注意点を整理し、あなたに合う選択肢をすばやく見つける。</p>
        <div class="hero-ctas">
          <a href="/#service-guides" class="hero-cta hero-cta-primary">
            <span class="hero-cta-icon">📋</span>
            サービス選びの確認ガイドを見る
          </a>
          <a href="/#products" class="hero-cta hero-cta-secondary">
            <span class="hero-cta-icon">⚡</span>
            急ぎの商品・発注先を探す
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-visual-grid">
          <div class="hero-visual-item hero-visual-1">仕事</div>
          <div class="hero-visual-item hero-visual-2">お金</div>
          <div class="hero-visual-item hero-visual-3">暮らし</div>
          <div class="hero-visual-item hero-visual-4">美容</div>
          <div class="hero-visual-item hero-visual-5">結婚</div>
          <div class="hero-visual-item hero-visual-6">購買</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ② 何にお困りですか？ - 悩み別ナビゲーション -->
  <!-- ============================================ -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <h2>何にお困りですか？</h2>
      </div>
      <div class="concern-grid">
        {
          concernFinder.map((concern) =>
            concern.href ? (
              <a href={concern.href} class="concern-card concern-card-link card">
                <h3>{concern.label}</h3>
                <p class="concern-description">{concern.description}</p>
                <span class="concern-cta">詳しく見る →</span>
              </a>
            ) : (
              <div class="concern-card concern-card-disabled card">
                <h3>{concern.label}</h3>
                <p class="concern-description">{concern.description}</p>
                <span class="concern-cta">準備中</span>
              </div>
            )
          )
        }
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ③ サービス選びの確認ガイド -->
  <!-- ============================================ -->
  {
    guideGenres.length > 0 && (
      <section class="section" id="service-guides">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">SERVICE GUIDE</span>
            <h2>サービス選びの確認ガイド</h2>
            <p>お金・美容・健康・結婚など、悩み別にサービス比較ガイドを提供</p>
          </div>
          <div class="service-guides-grid">
            {guideGenres.map((genre) =>
              genre.lps.map((lp) => (
                <a href={lp.path} class="service-guide-card card">
                  <p class="service-guide-category">{genre.name}</p>
                  <p class="service-guide-title">{lp.title}</p>
                  <p class="service-guide-description">{lp.description}</p>
                </a>
              ))
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============================================ -->
  <!-- ④ 急ぎの商品・発注先を探す -->
  <!-- ============================================ -->
  <section class="section section-soft" id="products">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">PRODUCTS & SERVICES</span>
        <h2>急ぎの商品・発注先を探す</h2>
        <p>DM・印刷・発電機・オフィス用品など、最短納期の商品・サービスを比較</p>
      </div>
      <div class="category-grid">
        {
          categories.map((c) => {
            const provider = primaryProvider(c);
            const sKey = speedKey(c);
            return (
              <CategoryCard
                name={c.name}
                href={`/categories/${c.slug}/`}
                speedValue={sKey ? (provider?.values[sKey] as string) : undefined}
                minQuantityValue={provider?.values["minQuantity"] as string | undefined}
                providerCount={c.providers.length}
              />
            );
          })
        }
        {
          commerceCategories.map((cc) => (
            <CategoryCard
              name={cc.name}
              href={cc.href}
              speedLabel={cc.speedLabel}
              speedValue={cc.speedValue}
            />
          ))
        }
        {
          upcomingCategories
            .slice(0, 5)
            .map((u) => <CategoryCard name={u.name} href={u.href} ctaLabel={u.href ? "読む →" : undefined} />)
        }
      </div>
      <p class="see-all">
        <a href="/categories/">すべてのカテゴリーを見る →</a>
      </p>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ⑤ オリジナルTシャツ・グッズ（UP-T） -->
  <!-- ============================================ -->
  <UptPromoBanner />

  <!-- ============================================ -->
  <!-- ⑥ 困ったときの確認ガイド -->
  <!-- ============================================ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">QUICK GUIDE</span>
        <h2>困ったときの確認ガイド</h2>
      </div>
      <div class="guide-grid">
        <GuideCard
          guide={{
            title: "新しいNISAの仕組み",
            description: "口座選びのポイント・手数料・取扱商品",
            href: "/lp/affiliate/securities/nisa/",
          }}
        />
        <GuideCard
          guide={{
            title: "今日中に発電機を手配する",
            description: "最短配送と注意点",
            href: "/guides/urgent-handle-generator-today/",
          }}
        />
        <GuideCard
          guide={{
            title: "会議を明日開く時に必要な機器",
            description: "プロジェクター・モニター・チェア",
            href: "/guides/urgent-meeting-equipment/",
          }}
        />
        <GuideCard
          guide={{
            title: "ダイレクトメール発送のポイント",
            description: "スピード優先プランと料金比較",
            href: "/categories/dm/",
          }}
        />
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ⑦ サイト紹介・運営情報 -->
  <!-- ============================================ -->
  <section class="section section-soft">
    <div class="container">
      <div class="site-intro card">
        <h2>SOKUNOBANK(即納バンク)について</h2>
        <p>
          SOKUNOBANK(即納バンク)は、商品やサービスを選ぶための条件・費用・注意点を整理し、悩みを解決するための判断材料を提供する情報サイトです。
        </p>
        <p>
          「仕事の急な対応」「暮らしの悩み」「お金の選択肢」など、様々な場面で必要な情報を、最短で見つけられるプラットフォームを目指します。
        </p>
        <p class="disclaimer">
          <strong>※重要:</strong>
          本サイトで提供する情報は、商品・サービス選びの判断材料です。成果や効果を保証するものではありません。ご利用は自己責任でお願いします。
        </p>
        <div class="footer-links">
          <a href="/privacy/">プライバシーポリシー</a> |
          <a href="/about/">運営者情報</a> |
          <a href="/advertising/">広告掲載方針</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* ファーストビュー - 新コンセプト */
  .hero-new {
    background: linear-gradient(135deg, var(--color-bg-soft) 0%, var(--color-bg) 100%);
    padding: 3rem 1rem;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-title {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-text);
    font-weight: 500;
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
    font-size: 0.95rem;
  }

  .hero-cta-primary {
    background: var(--color-accent);
    color: white;
  }

  .hero-cta-primary:hover {
    background: var(--color-accent-dark);
    transform: translateY(-2px);
  }

  .hero-cta-secondary {
    background: white;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .hero-cta-secondary:hover {
    background: var(--color-bg-soft);
  }

  .hero-cta-icon {
    font-size: 1.25rem;
  }

  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-visual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    width: 100%;
  }

  .hero-visual-item {
    aspect-ratio: 1;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: white;
    font-size: 1.1rem;
    transition: transform 0.3s;
  }

  .hero-visual-item:hover {
    transform: scale(1.05);
  }

  .hero-visual-1 {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    grid-row: span 2;
  }

  .hero-visual-2 {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  }

  .hero-visual-3 {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  }

  .hero-visual-4 {
    background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  }

  .hero-visual-5 {
    background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  }

  .hero-visual-6 {
    background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);
    grid-row: span 2;
  }

  /* 何にお困りですか？ */
  .concern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .concern-card {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.2s;
  }

  .concern-card-link {
    text-decoration: none;
    color: inherit;
  }

  .concern-card-link:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .concern-card-link:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .concern-card-disabled {
    opacity: 0.7;
    cursor: default;
  }

  .concern-card h3 {
    font-size: 1.3rem;
    margin: 0;
    font-weight: 600;
    color: var(--color-accent);
  }

  .concern-description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    flex-grow: 1;
    line-height: 1.5;
  }

  .concern-cta {
    font-size: 0.95rem;
    color: var(--color-accent);
    font-weight: 600;
    display: inline-block;
  }

  /* サービス選びの確認ガイド */
  .service-guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .service-guide-card {
    padding: 1.5rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.2s;
  }

  .service-guide-card:hover {
    border-color: var(--color-accent);
    background: white;
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .service-guide-card:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .service-guide-category {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
  }

  .service-guide-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .service-guide-description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* サイト紹介 */
  .site-intro {
    padding: 2rem;
    text-align: center;
  }

  .site-intro h2 {
    margin-bottom: 1.5rem;
  }

  .site-intro p {
    margin-bottom: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .disclaimer {
    background: var(--color-bg-soft);
    padding: 1rem;
    border-left: 4px solid var(--color-urgent);
    margin: 1.5rem 0;
    text-align: left;
  }

  .footer-links {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  /* レスポンシブ */
  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-visual-grid {
      grid-template-columns: 1fr 1fr;
    }

    .hero-visual-1 {
      grid-row: unset;
      grid-column: span 1;
    }

    .hero-visual-6 {
      grid-row: unset;
      grid-column: span 1;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-cta {
      justify-content: center;
      width: 100%;
    }

    .hero-visual-grid {
      grid-template-columns: 1fr;
    }

    .concern-grid {
      grid-template-columns: 1fr;
    }

    .service-guides-grid {
      grid-template-columns: 1fr;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
