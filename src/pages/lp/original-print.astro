<script>
  import {
    EMPTY_ANSWERS,
    HEADLINE_BY_ANSWER,
    DEFAULT_SUB,
    LP_SLUG,
    buildGuide,
    type Answers,
    type QuestionKey,
  } from "../../data/lp/original-print";
  import { DEFAULT_PRODUCT_ID, detectProduct, getProduct } from "../../data/lp/original-print-products";
  import { productArt } from "../../data/lp/product-art";
  import { UPT_LINKS } from "../../data/lp/upt-ads";

  type Tracker = (name: string, params: Record<string, unknown>) => void;
  const w = window as unknown as {
    sokunobankTrackEvent?: Tracker;
    sokunobankGetAttribution?: () => Record<string, unknown>;
    sokunobankDebounceClick?: (el: HTMLElement, fn: () => void) => void;
    sokunobankTrackUptConversion?: () => void;
  };

  // 既存の計測関数(Layout.astro)を使う。Yahoo!広告の離脱CVを発火する sokunobankTrackOutboundClick は使わない。
  // 値はすべて固定ID(個人情報・自由入力・日付そのものは送らない)。
  function track(name: string, params: Record<string, unknown>) {
    try {
      const attribution = typeof w.sokunobankGetAttribution === "function" ? w.sokunobankGetAttribution() : {};
      w.sokunobankTrackEvent?.(name, { lp: LP_SLUG, ...attribution, ...params });
    } catch {
      // 計測の失敗でページ機能を止めない
    }
  }

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const $$ = <T extends HTMLElement = HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

  // LP専用のクリック計測(回答つき)を使うため、共通ハンドラー(Header.astro)の upt_ad_click を無効にする
  document.documentElement.dataset.uptLp = "1";

  const answers: Answers = { ...EMPTY_ANSWERS, product: DEFAULT_PRODUCT_ID };
  let lastKey: QuestionKey | null = null;

  function daysBucket(n: number | null): string | undefined {
    if (n === null || n < 0) return undefined;
    if (n <= 7) return "within_7";
    if (n <= 14) return "8_to_14";
    return "15_plus";
  }

  function setText(sel: string, text: string) {
    const el = $(sel);
    if (el) el.textContent = text;
  }
  function setList(sel: string, items: string[]) {
    const ul = $(sel);
    if (!ul) return;
    ul.textContent = "";
    items.forEach((t) => {
      const li = document.createElement("li");
      li.textContent = t;
      ul.appendChild(li);
    });
  }

  /**
   * A8商品リンク(キャップの商品)は、キャップ選択時だけ読み込む。最初にキャップが選ばれたときに、原文のコードを
   * そのまま(span → 外部スクリプト → インラインスクリプトの順に)実行する。以後は表示/非表示の切り替えのみ。
   */
  let productLinkLoaded = false;
  function toggleProductLink(show: boolean) {
    const box = $("[data-pick-product]");
    const slot = $("[data-pick-product-slot]");
    const json = $("[data-product-link-json]");
    if (!box || !slot || !json) return;
    if (show && !productLinkLoaded) {
      productLinkLoaded = true;
      try {
        // 商品の横のテキストリンク(A8発行の原文。スクリプトを含まないHTML)
        const textJson = $("[data-cap-text-json]");
        const textBox = $("[data-pick-product-text]");
        if (textJson && textBox) textBox.innerHTML = JSON.parse(textJson.textContent ?? '""');
        const code: string = JSON.parse(json.textContent ?? '""');
        const tmp = document.createElement("div");
        tmp.innerHTML = code; // scriptは挿入されても実行されない(原文の構造をそのまま取り出す)
        const scripts = Array.from(tmp.querySelectorAll("script"));
        tmp.querySelectorAll("script").forEach((n) => n.remove());
        while (tmp.firstChild) slot.appendChild(tmp.firstChild);
        const run = (i: number) => {
          if (i >= scripts.length) return;
          const orig = scripts[i];
          const el = document.createElement("script");
          el.type = orig.type || "text/javascript";
          const src = orig.getAttribute("src");
          if (src) {
            el.src = src;
            el.onload = () => run(i + 1);
            el.onerror = () => run(i + 1);
            slot.appendChild(el);
          } else {
            el.text = orig.textContent ?? "";
            slot.appendChild(el);
            run(i + 1);
          }
        };
        run(0);
      } catch {
        // 広告の読み込み失敗でページの機能を止めない
      }
    }
    box.hidden = !show;
  }

  /** 商品と関連情報だけを更新する(フォームの他の回答はリセットしない) */
  function renderProduct() {
    const p = getProduct(answers.product) ?? getProduct(DEFAULT_PRODUCT_ID)!;
    setText("[data-lp-product]", p.shortName);
    // メインCTA(素材ID 1)のリンク文言だけを商品に合わせて更新する(href・計測画像は変更しない)
    const heroLink = $('[data-ad-position="hero"] a');
    if (heroLink) heroLink.textContent = `Up-Tで${p.shortName}を選んで納期を確認`;
    // キャップ選択時は、キャップ商品のテキストリンク(A8発行)に遷移先を切り替える。それ以外は一覧ページ(results)
    const linkKey = p.id === "cap" ? "cap" : "results";
    ["hero", "pick_button"].forEach((pos) => {
      const a = $(`[data-ad-position="${pos}"] a`) as HTMLAnchorElement | null;
      if (!a) return;
      const target = UPT_LINKS[linkKey];
      if (a.getAttribute("href") !== target.href) a.setAttribute("href", target.href);
      const px = a.parentElement?.querySelector<HTMLImageElement>('img[width="1"]');
      if (px && px.getAttribute("src") !== target.pixel) px.setAttribute("src", target.pixel);
    });
    setText("[data-lp-catch]", p.catchcopy);
    setText("[data-combo-label]", p.name);
    const comboArt = $("[data-combo-art]");
    if (comboArt) comboArt.innerHTML = productArt(p.art);
    $$("[data-option]").forEach((el) => el.setAttribute("aria-selected", String(el.dataset.option === p.id)));
    $$("[data-product-btn]").forEach((el) => el.setAttribute("aria-pressed", String(el.dataset.productBtn === p.id)));

    setText("[data-pick-name]", p.name);
    toggleProductLink(p.id === "cap");
    const pickLink = $('[data-ad-position="pick_button"] a');
    if (pickLink) pickLink.textContent = `Up-Tで${p.name}の商品と納期を確認する`;
    setText("[data-pick-lead]", p.lead);
    const art = $("[data-pick-art]");
    if (art) art.innerHTML = productArt(p.art);
    setList("[data-pick-design]", p.design);
    setList("[data-pick-checks]", p.checks);

    const scenes = $("[data-scenes]");
    if (scenes) {
      scenes.textContent = "";
      p.uses.forEach((u) => {
        const card = document.createElement("div");
        card.className = "scene";
        const img = document.createElement("div");
        img.className = "scene-img";
        if (u.image) {
          const im = document.createElement("img");
          im.src = u.image.src;
          if (u.image.srcset) im.srcset = u.image.srcset;
          im.width = u.image.width;
          im.height = u.image.height;
          im.alt = u.image.alt;
          im.loading = "lazy";
          img.appendChild(im);
        } else {
          img.innerHTML = productArt(p.art);
        }
        const t = document.createElement("p");
        t.className = "scene-title";
        t.textContent = u.title;
        const s = document.createElement("p");
        s.className = "scene-sub";
        s.textContent = u.sub;
        card.append(img, t, s);
        scenes.appendChild(card);
      });
    }
    renderGuide();
    renderCopy();
  }

  function renderGuide() {
    const g = buildGuide(answers);
    setText("[data-guide-method]", g.method);
    setText("[data-guide-deadline]", g.deadline);
    setText("[data-guide-cta]", g.ctaLead);
    setList("[data-guide-prepare]", g.prepare);
  }

  /** 右側のサブコピー: 直近に選んだ回答(デザイン・納期・数量)に連動する。商品は見出しに反映 */
  function renderCopy() {
    const v = lastKey ? answers[lastKey] : null;
    const copy = lastKey && v ? HEADLINE_BY_ANSWER[`${lastKey}:${v}`] : null;
    const cur = getProduct(answers.product) ?? getProduct(DEFAULT_PRODUCT_ID)!;
    setText("[data-lp-sub]", copy ? copy.headline : cur.subcopy);
  }

  // --- 商品の選択(PCプルダウン・PCストリップ・スマホグリッド共通) ---
  let userSelected = false;
  function selectProduct(id: string, source: string) {
    const p = getProduct(id);
    if (!p) return;
    if (source !== "intent") userSelected = true;
    const changed = answers.product !== p.id;
    answers.product = p.id;
    renderProduct();
    if (changed || source === "intent") {
      track("product_selected", { product: p.id, product_group: p.group, source });
    }
  }

  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLElement>("[data-product-btn]");
    if (btn?.dataset.productBtn) {
      selectProduct(btn.dataset.productBtn, btn.closest("[data-pgrid]") ? "grid" : "strip");
    }
  });

  // --- PC: 階層+検索つきプルダウン ---
  const combo = $("[data-combo]");
  const comboBtn = $<HTMLButtonElement>(".combo-btn");
  const pop = $("[data-combo-pop]");
  const search = $<HTMLInputElement>("[data-combo-search]");
  const empty = $("[data-combo-empty]");
  let activeIdx = -1;

  const visibleOptions = () => $$("[data-option]").filter((o) => !o.hidden);
  function setActive(idx: number) {
    const opts = visibleOptions();
    $$("[data-option]").forEach((o) => o.classList.remove("is-active"));
    activeIdx = Math.max(-1, Math.min(idx, opts.length - 1));
    const el = opts[activeIdx];
    if (el) {
      el.classList.add("is-active");
      el.scrollIntoView({ block: "nearest" });
      search?.setAttribute("aria-activedescendant", el.id);
    } else {
      search?.removeAttribute("aria-activedescendant");
    }
  }
  function filterOptions(q: string) {
    const needle = q.trim().toLowerCase();
    $$("[data-option]").forEach((o) => {
      o.hidden = needle !== "" && !(o.dataset.name ?? "").includes(needle);
    });
    $$("[data-group-head]").forEach((h) => {
      const g = h.dataset.groupHead;
      h.hidden = !$$("[data-option]").some((o) => o.dataset.group === g && !o.hidden);
    });
    if (empty) empty.hidden = visibleOptions().length > 0;
    setActive(visibleOptions().length > 0 ? 0 : -1);
  }
  function openCombo() {
    if (!pop || !comboBtn) return;
    pop.hidden = false;
    comboBtn.setAttribute("aria-expanded", "true");
    if (search) {
      search.value = "";
      filterOptions("");
      search.focus();
    }
    setActive(visibleOptions().findIndex((o) => o.dataset.option === answers.product));
  }
  function closeCombo(focusBtn = false) {
    if (!pop || !comboBtn || pop.hidden) return;
    pop.hidden = true;
    comboBtn.setAttribute("aria-expanded", "false");
    if (focusBtn) comboBtn.focus();
  }
  comboBtn?.addEventListener("click", () => (pop?.hidden ? openCombo() : closeCombo()));
  comboBtn?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      openCombo();
    }
  });
  search?.addEventListener("input", () => filterOptions(search.value));
  search?.addEventListener("keydown", (e) => {
    const opts = visibleOptions();
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(Math.min(activeIdx + 1, opts.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(Math.max(activeIdx - 1, 0));
    } else if (e.key === "Enter") {
      e.preventDefault();
      const el = opts[activeIdx];
      if (el?.dataset.option) {
        selectProduct(el.dataset.option, "dropdown");
        closeCombo(true);
      }
    } else if (e.key === "Escape" || e.key === "Tab") {
      closeCombo(e.key === "Escape");
    }
  });
  $("[data-combo-list]")?.addEventListener("click", (e) => {
    const el = (e.target as Element).closest<HTMLElement>("[data-option]");
    if (el?.dataset.option) {
      selectProduct(el.dataset.option, "dropdown");
      closeCombo(true);
    }
  });
  document.addEventListener("click", (e) => {
    if (combo && !combo.contains(e.target as Node)) closeCombo();
  });

  // --- スマホ: グループタブ+「すべてのアイテムから選ぶ」 ---
  const COLLAPSED_COUNT = 6;
  let activeTab = "all";
  let expanded = false;
  const moreBtn = $<HTMLButtonElement>("[data-pmore]");
  function applyGrid() {
    const items = $$("[data-pgrid-list] [data-product-btn]");
    const inTab = items.filter((i) => activeTab === "all" || i.dataset.group === activeTab);
    items.forEach((i) => {
      const idx = inTab.indexOf(i);
      i.hidden = idx < 0 || (!expanded && idx >= COLLAPSED_COUNT);
    });
    if (moreBtn) {
      moreBtn.hidden = inTab.length <= COLLAPSED_COUNT;
      moreBtn.setAttribute("aria-expanded", String(expanded));
      moreBtn.textContent = expanded ? "閉じる" : "すべてのアイテムから選ぶ →";
    }
  }
  const tabs = $$<HTMLButtonElement>(".ptab");
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => {
      activeTab = t.dataset.tab ?? "all";
      expanded = false;
      tabs.forEach((x) => x.setAttribute("aria-selected", String(x === t)));
      applyGrid();
    });
    t.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      const next = tabs[(i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length];
      next.focus();
      next.click();
    });
  });
  moreBtn?.addEventListener("click", () => {
    expanded = !expanded;
    applyGrid();
  });
  applyGrid();

  // --- Q1/Q3/Q4(デザイン・納期・数量) ---
  const form = $<HTMLFormElement>("[data-lp-form]");
  const dateRow = $("[data-date-row]");
  const dateInput = $<HTMLInputElement>("#use-date");

  function updateDays() {
    const v = dateInput?.value;
    if (!v) {
      answers.daysLeft = null;
      return;
    }
    const [y, m, d] = v.split("-").map(Number);
    const target = new Date(y, m - 1, d).getTime();
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    answers.daysLeft = Math.round((target - today) / 86400000);
  }

  form?.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "use-date") {
      updateDays();
      renderGuide();
      track("lp_select", { question: "deadline", answer: "date_value_set", days_bucket: daysBucket(answers.daysLeft) });
      return;
    }
    if (t.name !== "design" && t.name !== "deadline" && t.name !== "qty") return;
    const key = t.name as QuestionKey;
    (answers as unknown as Record<string, string | null>)[key] = t.value;
    if (key === "deadline") {
      if (dateRow) dateRow.hidden = t.value !== "date";
      if (t.value !== "date") answers.daysLeft = null;
      else updateDays();
    }
    lastKey = key;
    renderCopy();
    renderGuide();
    track("lp_select", { question: key, answer: t.value });
  });

  $("[data-guide-link]")?.addEventListener("click", () => {
    track("lp_guide_open", {
      design: answers.design ?? undefined,
      product: answers.product ?? undefined,
      deadline: answers.deadline ?? undefined,
      qty: answers.qty ?? undefined,
    });
  });

  // --- キーワード流入からの初期選択(ユーザー自身の選択を優先) ---
  try {
    const qs = new URLSearchParams(window.location.search);
    const found = detectProduct(["item", "product", "intent", "utm_term", "utm_content", "q"].map((k) => qs.get(k) ?? ""));
    if (found && !userSelected) selectProduct(found.id, "intent");
  } catch {
    // no-op
  }

  // --- 広告バナー: PC用(素材ID 74)/スマホ用(素材ID 15)のうち、該当する方だけを挿入する ---
  const isMobileBanner = window.matchMedia("(max-width: 720px)").matches;
  $$("[data-upt-banner]").forEach((box) => {
    const slot = box.querySelector<HTMLElement>("[data-banner-slot]");
    const src = box.querySelector<HTMLScriptElement>(`script[data-variant="${isMobileBanner ? "mobile" : "pc"}"]`);
    if (slot && src?.textContent) {
      // 広告コードの原文をそのままHTMLとして挿入する(加工しない)
      slot.innerHTML = src.textContent;
      slot.dataset.uptAd = isMobileBanner ? "15" : "74";
      slot.dataset.adType = "banner";
      slot.dataset.adPosition = box.dataset.position ?? "";
    }
  });

  // --- 広告クリックの計測(リスナー追加のみ。遷移・広告コードには干渉しない) ---
  document.addEventListener(
    "click",
    (e) => {
      const el = (e.target as Element | null)?.closest<HTMLElement>("[data-upt-ad]");
      if (!el || !(e.target as Element).closest("a")) return;
      const run = () => {
        // LINEヤフー広告の離脱クリックCV(Up-T送客)。リンク・広告コードには触れず、発火のみ行う
        w.sokunobankTrackUptConversion?.();
        track("upt_ad_click", {
          ad_id: el.dataset.uptAd,
          ad_type: el.dataset.adType,
          ad_position: el.dataset.adPosition || undefined,
          design: answers.design ?? undefined,
          product: answers.product ?? undefined,
          deadline: answers.deadline ?? undefined,
          qty: answers.qty ?? undefined,
          days_bucket: daysBucket(answers.daysLeft),
        });
      };
      if (typeof w.sokunobankDebounceClick === "function") w.sokunobankDebounceClick(el, run);
      else run();
    },
    true,
  );

  renderProduct();
</script>
