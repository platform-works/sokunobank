---
// Up-T(オリジナルプリント)送客LP。広告LP(noindex)。
// 既存の /lp/[slug]/ とは別の静的ルートとして追加(カテゴリーデータ・既存LPには影響しない)。
// 広告コード(A8.net)は upt-ads.ts の原文を set:html でそのまま出力する(改変禁止)。
// 商品マスターは original-print-products.ts、イメージ図は product-art.ts。
import Layout from "../../layouts/Layout.astro";
import FaqSection from "../../components/FaqSection.astro";
import { QUESTIONS, DEFAULT_SUB, EMPTY_ANSWERS, FAQ_ITEMS, buildGuide } from "../../data/lp/original-print";
import {
  PRODUCT_GROUPS,
  PUBLISHED_PRODUCTS,
  DEFAULT_PRODUCT_ID,
  getProduct,
} from "../../data/lp/original-print-products";
import { productArt } from "../../data/lp/product-art";
import { UPT_AD_BANNER_74_PC, UPT_AD_BANNER_15_MOBILE, UPT_PRODUCT_LINK, UPT_CAP_TEXT_LINK, uptTextAd } from "../../data/lp/upt-ads";
import UptAdButton from "../../components/UptAdButton.astro";

const product = getProduct(DEFAULT_PRODUCT_ID)!;
// メインCTAのリンク文言(素材ID 1は自由入力のテキスト広告)。商品名に連動し、次のページへ進みたくなる行動文にする。
// 納期・価格などを保証する表現は使わない。
// 商品リンクのコード(原文)をJSON文字列にする。"<" を \u003c にして、</script> による誤終了を防ぐ(JSON.parse で原文に戻る)
const productLinkJson = JSON.stringify(UPT_PRODUCT_LINK).replace(/</g, "\\u003c");
const capTextLinkJson = JSON.stringify(UPT_CAP_TEXT_LINK).replace(/</g, "\\u003c");
function pickCtaLabel(name: string): string {
  return `Up-Tで${name}の商品と納期を確認する`;
}
function heroCtaLabel(shortName: string): string {
  return `Up-Tで${shortName}を選んで納期を確認`;
}
const guide = buildGuide({ ...EMPTY_ANSWERS, product: product.id });
const qs = QUESTIONS;
const grouped = PRODUCT_GROUPS.map((g) => ({ ...g, items: PUBLISHED_PRODUCTS.filter((p) => p.group === g.id) })).filter(
  (g) => g.items.length > 0,
);
const heroBase = "/images/lp/original-print/up-t-hero";
const reasons = [
  {
    title: "簡単デザイン・入稿",
    text: "データの入稿から、デザインの進め方の確認まで。条件に合わせて整理します。",
    icon: '<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 6C13 6 6 14 6 23s6 11 11 11h3c2 0 3 1 3 3 0 3 2 5 5 5 9 0 14-8 14-17C42 14 34 6 24 6z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><circle cx="16" cy="22" r="2.5"/><circle cx="23" cy="15" r="2.5"/><circle cx="32" cy="18" r="2.5"/></svg>',
  },
  {
    title: "豊富なアイテム",
    text: "Tシャツから雑貨まで。作りたいものから選べます。",
    icon: '<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5 7 13v22l17 8 17-8V13z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M7 13l17 8 17-8M24 21v22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>',
  },
  {
    title: "納期の確認",
    text: "商品・数量・配送先・注文確定時刻によって、発送可能日が変わります。",
    icon: '<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M4 12h26v22H4zM30 20h9l5 6v8H30z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><circle cx="14" cy="36" r="4" fill="#fff" stroke="currentColor" stroke-width="2.4"/><circle cx="37" cy="36" r="4" fill="#fff" stroke="currentColor" stroke-width="2.4"/></svg>',
  },
];
---

<Layout
  title="オリジナルプリントの発注方法と納期確認のポイント"
  description="オリジナルグッズの発注前に、デザインの有無・商品・納期・数量から、発注方法と事前準備を整理します。(PR)"
  noindex
>
  <section class="uphero" aria-labelledby="lp-h1">
    <div class="container uphero-grid">
      <p class="pr-line">
        <span class="pr-badge">PR</span>
        <span>広告を含みます。制作・発送はUp-T(広告主)が行います。</span>
      </p>

      <div class="copy">
        <h1 id="lp-h1" data-lp-headline>
          オリジナル<span data-lp-product>{product.shortName}</span>、<em data-lp-catch>{product.catchcopy}</em>
        </h1>
        <p class="copy-sub" data-lp-sub>{product.subcopy}</p>
      </div>

      <!-- ファーストビューの主要画像: 遅延読み込みしない(fetchpriority=high)。AVIF/WebPの複数幅(srcset) -->
      <picture class="hero-pic">
        <source
          type="image/avif"
          srcset={`${heroBase}-960.avif 960w, ${heroBase}-1672.avif 1672w`}
          sizes="(min-width: 900px) 1100px, 100vw"
        />
        <source
          type="image/webp"
          srcset={`${heroBase}-960.webp 960w, ${heroBase}-1672.webp 1672w`}
          sizes="(min-width: 900px) 1100px, 100vw"
        />
        <img
          src={`${heroBase}-1672.webp`}
          width="1672"
          height="941"
          alt="オリジナルグッズを手に笑顔の学生たちのイメージ"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <form class="selector card" data-lp-form onsubmit="return false" aria-label="発注条件の選択">
        <div class="q-grid">
          <!-- Q1 デザイン -->
          <fieldset class="q" data-q="design">
            <legend><span class="qn">Q1</span>{qs[0].label}</legend>
            <div class="opts">
              {
                qs[0].options.map((o) => (
                  <label class="opt">
                    <input type="radio" name="design" value={o.value} />
                    <span>{o.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- Q2 商品: PCはプルダウン(階層+検索)、スマホは画像付きボタン -->
          <div class="q q-product" data-q="product">
            <p class="q-title" id="q-product-title"><span class="qn">Q2</span>何を作りますか?</p>

            <div class="combo pc-only" data-combo>
              <button
                type="button"
                class="combo-btn"
                id="q-product"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="combo-pop"
                aria-labelledby="q-product-title combo-label"
              >
                <span class="combo-art" data-combo-art set:html={productArt(product.art)} />
                <span class="combo-label" id="combo-label" data-combo-label>{product.name}</span>
                <span class="combo-caret" aria-hidden="true"></span>
              </button>
              <div class="combo-pop" id="combo-pop" data-combo-pop hidden>
                <input
                  type="search"
                  class="combo-search"
                  placeholder="商品名で検索"
                  aria-label="商品名で検索"
                  aria-controls="combo-list"
                  autocomplete="off"
                  data-combo-search
                />
                <ul class="combo-list" id="combo-list" role="listbox" aria-label="商品" data-combo-list>
                  {
                    grouped.map((g) => (
                      <>
                        <li role="presentation" class="combo-group" data-group-head={g.id}>
                          {g.label}
                        </li>
                        {g.items.map((p) => (
                          <li
                            role="option"
                            id={`opt-${p.id}`}
                            class="combo-opt"
                            data-option={p.id}
                            data-group={g.id}
                            data-name={`${p.name} ${p.shortName} ${p.keywords.join(" ")}`.toLowerCase()}
                            aria-selected={p.id === product.id ? "true" : "false"}
                          >
                            <span class="combo-art" set:html={productArt(p.art)} />
                            <span>{p.name}</span>
                          </li>
                        ))}
                      </>
                    ))
                  }
                </ul>
                <p class="combo-empty" data-combo-empty hidden>該当する商品がありません</p>
              </div>
            </div>

            <div class="pgrid-wrap sp-only" data-pgrid>
              <div class="ptabs" role="tablist" aria-label="商品グループ">
                <button type="button" role="tab" class="ptab" data-tab="all" aria-selected="true" id="ptab-all">すべて</button>
                {
                  grouped.map((g) => (
                    <button type="button" role="tab" class="ptab" data-tab={g.id} aria-selected="false" id={`ptab-${g.id}`}>
                      {g.label}
                    </button>
                  ))
                }
              </div>
              <div class="pgrid" role="group" aria-label="商品を選ぶ" data-pgrid-list>
                {
                  PUBLISHED_PRODUCTS.map((p) => (
                    <button
                      type="button"
                      class="pitem"
                      data-product-btn={p.id}
                      data-group={p.group}
                      aria-pressed={p.id === product.id ? "true" : "false"}
                    >
                      <span class="pitem-art" set:html={productArt(p.art)} />
                      <span class="pitem-name">{p.name}</span>
                      <span class="pitem-check" aria-hidden="true">✓</span>
                    </button>
                  ))
                }
              </div>
              <button type="button" class="pmore" data-pmore aria-expanded="false">すべてのアイテムから選ぶ →</button>
            </div>
          </div>

          <!-- Q3 納期 -->
          <fieldset class="q" data-q="deadline">
            <legend><span class="qn">Q3</span>{qs[1].label}</legend>
            <div class="opts">
              {
                qs[1].options.map((o) => (
                  <label class="opt">
                    <input type="radio" name="deadline" value={o.value} />
                    <span>{o.label}</span>
                  </label>
                ))
              }
            </div>
            <div class="date-row" data-date-row hidden>
              <label for="use-date">使用したい日</label>
              <input id="use-date" type="date" name="use-date" />
            </div>
          </fieldset>

          <!-- Q4 数量 -->
          <fieldset class="q" data-q="qty">
            <legend><span class="qn">Q4</span>{qs[2].label}</legend>
            <div class="opts">
              {
                qs[2].options.map((o) => (
                  <label class="opt">
                    <input type="radio" name="qty" value={o.value} />
                    <span>{o.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <!-- A8.net 素材ID 1(テキスト広告)をメインCTAとして配置。広告コードは原文のまま(文言も変更しない)。見た目は親要素のCSSのみでボタン化する -->
        <div class="main-ad">
          <p class="main-ad-label"><span class="pr-badge">PR</span>Up-T公式サイトへ(広告リンク)</p>
          <div class="ad-button" data-upt-ad="1" data-ad-type="text" data-ad-position="hero" set:html={uptTextAd(heroCtaLabel(product.shortName))} />
          <a class="guide-link" href="#guide" data-guide-link>条件の整理を見る</a>
        </div>
      </form>

      <p class="hero-note">発送日・割引の適用を保証するものではありません。最新の条件はUp-T公式でご確認ください。</p>
    </div>
  </section>

  <div class="container">
    <!-- PC: 作れるアイテムを横並びで探す(選択はフォームと同期) -->
    <section class="strip pc-only" aria-labelledby="strip-h">
      <h2 id="strip-h">作れるアイテムを探す <small>Tシャツから雑貨まで、作りたいものを選べます</small></h2>
      <div class="strip-list" data-strip>
        {
          PUBLISHED_PRODUCTS.map((p) => (
            <button type="button" class="sitem" data-product-btn={p.id} aria-pressed={p.id === product.id ? "true" : "false"}>
              <span class="sitem-art" set:html={productArt(p.art)} />
              <span class="sitem-name">{p.name}</span>
              <span class="pitem-check" aria-hidden="true">✓</span>
            </button>
          ))
        }
      </div>
    </section>

    <!-- 選んだ商品に連動する情報(商品名・紹介・デザイン方法・チェックポイント・利用シーン) -->
    <section class="pick" aria-live="polite" aria-labelledby="pick-h">
      <div class="pick-art">
        <div class="pick-art-img" data-pick-art set:html={productArt(product.art)} />
        <p class="pick-art-cap">商品のイメージ図(実際の商品写真ではありません)</p>
      </div>
      <div class="pick-body">
        <h2 id="pick-h">選んだアイテム: <span data-pick-name>{product.name}</span></h2>
        <p class="pick-lead" data-pick-lead>{product.lead}</p>
        <div class="pick-cols">
          <div>
            <h3>デザイン方法</h3>
            <ul data-pick-design>
              {product.design.map((d) => <li>{d}</li>)}
            </ul>
          </div>
          <div>
            <h3>注文前のチェックポイント</h3>
            <ul data-pick-checks>
              {product.checks.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
        <p class="pick-note" data-pick-note>商品名・取り扱い・仕様は、Up-T公式の商品ページでご確認ください。</p>
        <!-- A8.net 素材ID 1(自由入力のテキスト広告)。リンク文言のみ商品名に連動して書き換える(href・計測画像は原文のまま) -->
        <UptAdButton label={pickCtaLabel(product.name)} placement="pick_button" caption="Up-T公式サイトへ(広告リンク)" />

        <!-- A8.net 商品リンク(キャップの商品)。キャップ選択時だけ読み込んで表示する(他の商品では読み込まない)。
             コードは原文のまま JSON で保持(</ は \u003c にエスケープ。JSON.parse で原文に戻る)。クリックは [data-upt-ad] で計測する -->
        <div class="pick-product-link" data-upt-ad="product_link" data-ad-type="product" data-ad-position="pick_product" data-pick-product hidden>
          <p class="pick-product-caption"><span class="pr-badge">PR</span>Up-Tのキャップ商品の一例(広告リンク)</p>
          <div class="pick-product-row">
            <div class="pick-product-slot" data-pick-product-slot></div>
            <!-- A8テキストリンク(HUKPU・商品詳細へ)。原文のまま、キャップ選択時だけ注入する。クリックは cap_text_link として計測 -->
            <div class="pick-product-text" data-upt-ad="cap_text_link" data-ad-type="text" data-ad-position="pick_product_text" data-pick-product-text></div>
          </div>
        </div>
        <script type="application/json" data-product-link-json set:html={productLinkJson} />
        <script type="application/json" data-cap-text-json set:html={capTextLinkJson} />
      </div>
    </section>

    <section class="scenes-wrap" aria-labelledby="scenes-h">
      <h2 id="scenes-h">こんなシーンで選ばれています</h2>
      <div class="scenes" data-scenes>
        {
          product.uses.map((u) => (
            <div class="scene">
              <div class="scene-img" set:html={productArt(product.art)} />
              <p class="scene-title">{u.title}</p>
              <p class="scene-sub">{u.sub}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="reasons" aria-labelledby="reasons-h">
      <h2 id="reasons-h">選ばれる<strong>3つ</strong>の理由</h2>
      <ul class="reason-list">
        {
          reasons.map((r) => (
            <li class="reason">
              <span class="reason-icon" set:html={r.icon} />
              <div>
                <p class="reason-title">{r.title}</p>
                <p class="reason-text">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="guide card" id="guide" aria-live="polite">
      <h2>選んだ条件の整理</h2>
      <div class="guide-grid">
        <div>
          <h3>おすすめの発注方法</h3>
          <p data-guide-method>{guide.method}</p>
        </div>
        <div>
          <h3>事前に準備するもの</h3>
          <ul data-guide-prepare>
            {guide.prepare.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div>
          <h3>納期の確認について</h3>
          <p data-guide-deadline>{guide.deadline}</p>
        </div>
      </div>

      <div class="cta-box">
        <p class="cta-lead" data-guide-cta>{guide.ctaLead}</p>
        <!-- A8.net 素材ID 74(PC・728×90)/ 15(スマホ・300×250)。表示する方だけをDOMに挿入する(二重描画しない)。type="text/plain"の<script>は解析・描画されず、画像も読み込まれない -->
        <div class="ad-banner" data-upt-banner data-position="guide">
          <div class="ad-banner-slot" data-banner-slot></div>
          <script type="text/plain" data-variant="pc" set:html={UPT_AD_BANNER_74_PC} />
          <script type="text/plain" data-variant="mobile" set:html={UPT_AD_BANNER_15_MOBILE} />
        </div>
        <p class="note">
          リンク先はUp-T公式サイトです。表示内容・納期・料金は変更されることがあります。購入・申込前にUp-T公式の最新情報をご確認ください。
        </p>
      </div>
    </section>

    <section class="steps">
      <h2>発注前チェックリスト</h2>
      <ul class="checks">
        <li>いつ使うか(使用日・イベント日)を決めている</li>
        <li>何個必要か(サイズ・色ごとの内訳)を決めている</li>
        <li>デザインのデータ・ラフ案の有無を確認した</li>
        <li>印刷位置・範囲を決めている</li>
        <li>発送日と到着日は別であることを理解し、余裕を持った日程にしている</li>
      </ul>
    </section>

    <FaqSection items={FAQ_ITEMS} />

    <!-- 最後の念押し: 紹介先(Up-T)の情報と、A8素材ID 74(PC)/15(スマホ)。公式サイトのURLは直接リンクにせず、表記のみ(計測を妨げないため) -->
    <section class="closing card" aria-labelledby="closing-h">
      <p class="closing-pr"><span class="pr-badge">PR</span>広告</p>
      <h2 id="closing-h">条件が決まったら、Up-T公式サイトで確認</h2>
      <dl class="closing-info">
        <div>
          <dt>紹介先</dt>
          <dd>Up-T(アップティー)</dd>
        </div>
        <div>
          <dt>サービス</dt>
          <dd>オリジナルTシャツ・グッズの制作</dd>
        </div>
        <div>
          <dt>公式サイト</dt>
          <dd>up-t.jp</dd>
        </div>
        <div>
          <dt>確認すること</dt>
          <dd>商品・数量・配送先・注文確定時刻によって、発送可能日が変わります。注文前に公式サイトの表示をご確認ください。</dd>
        </div>
      </dl>
      <UptAdButton label="Up-T公式サイトで商品と納期を確認する" placement="footer_button" caption="最後に、Up-T公式サイトで確認" />
      <div class="ad-banner closing-banner" data-upt-banner data-position="footer">
        <div class="ad-banner-slot" data-banner-slot></div>
        <script type="text/plain" data-variant="pc" set:html={UPT_AD_BANNER_74_PC} />
        <script type="text/plain" data-variant="mobile" set:html={UPT_AD_BANNER_15_MOBILE} />
      </div>
      <p class="note">リンク先はUp-T公式サイトです。納期・料金は変更されることがあります。</p>
    </section>
  </div>
</Layout>

<style>
  /* ===== 表示切替(PC=900px以上) ===== */
  .pc-only {
    display: none;
  }
  @media (min-width: 900px) {
    .pc-only {
      display: block;
    }
    .sp-only {
      display: none;
    }
  }

  /* ===== ファーストビュー ===== */
  .uphero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(110deg, #ffffff 0%, var(--color-bg-soft-2) 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .uphero-grid {
    display: grid;
    gap: 0.9rem;
    padding-top: 0.9rem;
    padding-bottom: 1.25rem;
    grid-template-areas: "pr" "copy" "pic" "form" "note";
  }
  .pr-line {
    grid-area: pr;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .pr-badge {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .copy {
    grid-area: copy;
  }
  .copy h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.7rem, 7.4vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }
  .copy h1 em {
    font-style: normal;
    color: var(--color-accent-dark);
    display: inline-block;
  }
  .copy-sub {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .hero-pic {
    grid-area: pic;
    display: block;
  }
  .hero-pic img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 941;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }
  .hero-note {
    grid-area: note;
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .selector {
    grid-area: form;
    padding: 1rem;
  }

  /* ===== 選択フォーム ===== */
  .q-grid {
    display: grid;
    gap: 1rem;
