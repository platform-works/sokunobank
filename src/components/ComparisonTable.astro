---
import type { ComparisonField, Provider } from "../data/schema";

interface Props {
  fields: ComparisonField[];
  providers: Provider[];
  /** ComparisonFilterから絞り込み対象として参照するためのid */
  id?: string;
}
const { fields, providers, id = "comparison-table" } = Astro.props;

function formatValue(v: string | number | boolean | null): string {
  if (v === null || v === undefined) return "要確認";
  if (typeof v === "boolean") return v ? "あり" : "なし";
  return String(v);
}

const isUrgentText = (v: string) => /(当日|即日)/.test(v);

function toKebab(key: string): string {
  return key.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
}

function facetAttrs(provider: Provider): Record<string, string> {
  if (!provider.facets) return {};
  const attrs: Record<string, string> = {};
  for (const [key, value] of Object.entries(provider.facets)) {
    attrs[`data-facet-${toKebab(key)}`] = String(value);
  }
  return attrs;
}
---

<div class="table-wrap" id={id}>
  <table class="responsive-table">
    <thead>
      <tr>
        <th>事業者</th>
        {fields.map((f) => <th>{f.label}{f.unit ? `(${f.unit})` : ""}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        providers.map((p) => (
          <tr class={p.isPrimary ? "primary-row" : ""} data-provider={p.id} {...facetAttrs(p)}>
            <th scope="row">
              {p.name}
              {p.isPrimary && <span class="badge">メイン</span>}
            </th>
            {fields.map((f) => {
              const text = formatValue(p.values[f.key]);
              return (
                <td data-label={f.label}>
                  {isUrgentText(text) ? <span class="badge-urgent">{text}</span> : text}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0;
    border-radius: var(--radius-lg);
  }
  .primary-row {
    background: var(--color-accent-soft);
  }
</style>
