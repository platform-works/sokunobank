---
import type { ReaderPathway } from "../data/schema";

interface Props {
  pathways: ReaderPathway[];
  title?: string;
}
const { pathways, title = "あなたはどちらのタイプ?" } = Astro.props;
---

<section>
  <h2>{title}</h2>
  <div class="grid">
    {
      pathways.map((p) => (
        <div class="card pathway">
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <ul>
            {p.bestFor.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .pathway h3 {
    margin-top: 0;
  }
  .pathway ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
    color: var(--color-text-muted);
  }
</style>
