---
// 「必要容量は何Wh?」と簡易計算ツール(2026-09-30導入)。計算はブラウザ内で完結し、入力値は
// 送信・保存しない。結果は必ず「目安」として表示し、変換ロス等で表示容量のすべてを使えるわけではない
// 旨を明記する。初期値は generatorContent.ts の appliances(公表されている目安の上限側)。
import { appliances } from "../../../lib/commerce/generatorContent";
import { capacityBands } from "../../../lib/commerce/generatorClient";

const rows = appliances.map((a) => ({ id: a.id, label: a.label, watts: a.watts, hours: a.defaultHours, note: a.note }));
---

<section class="capacity-section" id="capacity">
  <div class="capacity-heading">
    <h2>必要容量は何Wh?</h2>
    <p>
      容量(Wh)の目安は「消費電力(W) × 使う時間(h) × 台数」を機器ごとに足して求めます。使う機器にチェックを入れてください。使用時間は入力例なので、想定に合わせて変更できます。
    </p>
  </div>

  <div class="quick-cta">
    <button type="button" class="btn btn-secondary" data-quick="capacity-low">{capacityBands[0].label.replace("〜", "")}以下の商品を見る</button>
    <button type="button" class="btn btn-secondary" data-quick="capacity-1000">1,000Wh以上の商品を見る</button>
    <button type="button" class="btn btn-secondary" data-quick="power-1500">1,500W以上の商品を見る</button>
  </div>

  <div class="calc" id="capacity-calc">
    <div class="calc-table-wrap">
      <table class="calc-table">
        <thead>
          <tr>
            <th scope="col">使う</th>
            <th scope="col">機器</th>
            <th scope="col">消費電力(W)</th>
            <th scope="col">台数</th>
            <th scope="col">使用時間(h)</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-row={r.id}>
                <td>
                  <input type="checkbox" data-role="use" aria-label={`${r.label}を使う`} />
                </td>
                <th scope="row">
                  {r.label}
                  <span class="calc-note">{r.note}</span>
                </th>
                <td>
                  <input type="number" inputmode="decimal" min="0" step="1" data-role="watts" value={r.watts ?? ""} aria-label={`${r.label}の消費電力(W)`} />
                </td>
                <td>
                  <input type="number" inputmode="numeric" min="1" step="1" data-role="qty" value="1" aria-label={`${r.label}の台数`} />
                </td>
                <td>
                  <input type="number" inputmode="decimal" min="0" step="0.1" data-role="hours" value={r.hours} aria-label={`${r.label}の使用時間(h)`} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="calc-result" aria-live="polite">
      <p class="result-main">必要容量の目安:<strong data-role="wh">約 — Wh</strong></p>
      <p class="result-sub">同時に使う機器の合計出力の目安:<strong data-role="w">約 — W</strong></p>
      <button type="button" class="btn btn-primary" data-role="apply" disabled>この容量以上の商品を見る</button>
    </div>
    <p class="calc-caution">
      あくまで目安です。変換ロス等のため、表示されているバッテリー容量のすべてを使えるわけではありません。余裕を持った容量・出力の機種を選んでください。機器の消費電力は銘板・取扱説明書で確認できます。
    </p>
  </div>
</section>

<script>
  import { capacityBands, powerBands, setSelection, trackFilterUse } from "../../../lib/commerce/generatorClient";

  const section = document.getElementById("capacity");
  if (section) {
    const rows = Array.from(section.querySelectorAll<HTMLTableRowElement>("tr[data-row]"));
    const whEl = section.querySelector<HTMLElement>('[data-role="wh"]');
    const wEl = section.querySelector<HTMLElement>('[data-role="w"]');
    const applyBtn = section.querySelector<HTMLButtonElement>('[data-role="apply"]');
    let lastWh = 0;

    function num(row: HTMLElement, role: string): number {
      const v = Number((row.querySelector(`[data-role="${role}"]`) as HTMLInputElement).value);
      return Number.isFinite(v) && v > 0 ? v : 0;
    }

    function update() {
      let wh = 0;
      let w = 0;
      for (const row of rows) {
        const on = (row.querySelector('[data-role="use"]') as HTMLInputElement).checked;
        if (!on) continue;
        const watts = num(row, "watts");
        const qty = num(row, "qty");
        wh += watts * qty * num(row, "hours");
        w += watts * qty;
      }
      lastWh = Math.ceil(wh / 10) * 10;
      const wRounded = Math.ceil(w / 10) * 10;
      if (whEl) whEl.textContent = lastWh > 0 ? `約 ${lastWh.toLocaleString("ja-JP")}Wh` : "約 — Wh";
      if (wEl) wEl.textContent = wRounded > 0 ? `約 ${wRounded.toLocaleString("ja-JP")}W` : "約 — W";
      if (applyBtn) applyBtn.disabled = lastWh <= 0;
    }

    section.addEventListener("input", update);
    update();

    function goToProducts() {
      document.getElementById("products")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    applyBtn?.addEventListener("click", () => {
      if (lastWh <= 0) return;
      setSelection({ capacity: { min: lastWh, max: null, label: `${lastWh.toLocaleString("ja-JP")}Wh以上(計算結果)` } });
      trackFilterUse("capacity_calculator", `${lastWh}Wh`);
      goToProducts();
    });

    section.querySelector('[data-quick="capacity-low"]')?.addEventListener("click", () => {
      setSelection({ capacity: capacityBands[0] });
      trackFilterUse("capacity_band", capacityBands[0].label);
      goToProducts();
    });
    section.querySelector('[data-quick="capacity-1000"]')?.addEventListener("click", () => {
      setSelection({ capacity: { min: 1000, max: null, label: "1,000Wh以上" } });
      trackFilterUse("capacity_band", "1,000Wh以上");
      goToProducts();
    });
    section.querySelector('[data-quick="power-1500"]')?.addEventListener("click", () => {
      setSelection({ power: powerBands[3] });
      trackFilterUse("power_band", powerBands[3].label);
      goToProducts();
    });
  }
</script>

<style>
  .capacity-section {
    margin: 2rem 0;
  }
  .capacity-heading h2 {
    margin: 0 0 0.3rem;
  }
  .capacity-heading p {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  .quick-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .calc-table-wrap {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }
  .calc-table {
    width: 100%;
    margin: 0;
    font-size: 0.86rem;
    border-collapse: collapse;
  }
  .calc-table th,
  .calc-table td {
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--color-border);
  }
  .calc-table thead th {
    background: var(--color-bg-soft);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .calc-note {
    display: block;
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .calc-table input[type="number"] {
    width: 5.5rem;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0 0.5rem;
    font-size: 0.92rem;
  }
  .calc-table input[type="checkbox"] {
    width: 22px;
    height: 22px;
  }
  .calc-result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .calc-result p {
    margin: 0;
    font-size: 0.92rem;
  }
  .result-main strong {
    font-size: 1.25rem;
    color: var(--color-accent-dark);
  }
  .calc-result .btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .calc-caution {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 720px) {
    .calc-result .btn {
      width: 100%;
    }
  }
</style>
