---
// 「とにかく急ぎの方」セクション(2026-09-28導入)。発電機カテゴリー専用。
// 既存のAPI(/api/generator/products/)をそのまま使い、取得済みの先頭数件を
// 「配送・出力」を優先した簡易カードで表示する。ProductGrid.astro(全商品一覧、既存・未変更)とは
// 別のクライアントスクリプトで、同じAPIエンドポイントに対して独立してfetchする
// (商品取得ロジック・Yahoo APIの呼び出し方は一切変更していない)。
interface Props {
  slug: string;
  apiPath: string;
}
const { slug, apiPath } = Astro.props;
const rootId = `generator-urgent-${slug}`;
---

<section class="urgent-section" id="urgent">
  <div class="urgent-heading">
    <h2>お届け先に早く届く商品</h2>
    <p>上でお届け先を選ぶと、その宛先へ最短で届く対象の発電機・ポータブル電源を表示します。</p>
  </div>
  <div class="urgent-grid" id={rootId} data-api-path={apiPath}>
    <p class="urgent-state urgent-loading" data-role="loading">商品情報を取得しています…</p>
    <p class="urgent-state urgent-empty" data-role="empty" hidden>
      現在ピックアップできる商品がありません。下の商品一覧からお探しください。
    </p>
    <ul class="urgent-list" data-role="list" hidden></ul>
  </div>
</section>

<script define:vars={{ rootId, slug }}>
  (function () {
    const root = document.getElementById(rootId);
    if (!root) return;
    const apiPath = root.dataset.apiPath;
    const loadingEl = root.querySelector('[data-role="loading"]');
    const emptyEl = root.querySelector('[data-role="empty"]');
    const listEl = root.querySelector('[data-role="list"]');
    const MAX_ITEMS = 4;

    function deliveryLabel(day) {
      // 当日到着(day=0)は現実的に成立しづらいため約束しない。取得できない場合は
      // 存在しない日付を作らず、確認を促す文言にフォールバックする(架空の配送日を作らない)。
      if (day === 1) return "明日到着対象";
      if (day === 2) return "翌々日到着対象";
      return "配送日は商品ページでご確認ください";
    }

    // 商品名から出力表記を抜き出す(extractPowerSpec.tsと同じロジックをクライアント用に複製)。
    // ビルド時にモジュールをそのままブラウザへ出せないため、同等のロジックをここに持たせている。
    function extractPowerSpec(name) {
      const patterns = [
        /定格出力\s*([0-9.]+\s*(?:kVA|kW|W))/i,
        /定格\s*([0-9.]+\s*(?:kVA|kW|W))/i,
        /出力\s*([0-9.]+\s*(?:kVA|kW|W))/i,
        /([0-9.]+\s*kVA)/i,
        /([0-9]{3,5}\s*W)(?!h)/i,
      ];
      for (const pattern of patterns) {
        const m = name.match(pattern);
        if (m && m[1]) return m[1].replace(/\s+/g, "");
      }
      return null;
    }

    function setState(state) {
      loadingEl.hidden = state !== "loading";
      emptyEl.hidden = state !== "empty";
      listEl.hidden = state !== "list";
    }

    // 2026-09-30: 商品一覧と同じ拡張(generatorClient.ts、GeneratorRuntime.astroが登録)を使い、
    // 「東京都宛て:明日お届け対象」形式の配送表示とGA4パラメータの追加を行う。
    // 拡張が未登録のタイミングでは従来の表示にフォールバックする。
    let currentArea = "";
    function getExt() {
      return window.sokunobankCardExtensions ? window.sokunobankCardExtensions.generator : undefined;
    }
    function deliveryLabelFor(p) {
      const ext = getExt();
      const text = ext && ext.deliveryText ? ext.deliveryText(p, { params: { area: currentArea } }) : null;
      return text || deliveryLabel(p.deliveryDay);
    }

    function createCard(p, index) {
      const li = document.createElement("li");
      li.className = "urgent-card";

      const a = document.createElement("a");
      a.className = "urgent-card-link";
      a.href = p.productUrl;
      a.target = "_blank";
      a.rel = "sponsored noopener";
      a.addEventListener("click", () => {
        // 既存のoutbound_product_click計測をそのまま使う(二重計測を避けるため、
        // このセクション専用の別イベントは発火しない。GA4側でproduct_name等から
        // 「急ぎセクション経由か」は判別しづらいが、それを理由に新イベントを増やすと
        // 既存の計測設計(1クリック=1outbound_product_click)と重複するため見送った)。
        if (window.sokunobankDebounceClick && window.sokunobankTrackOutboundClick) {
          window.sokunobankDebounceClick(a, () => {
            const ext = getExt();
            const extra = ext && ext.trackParams ? ext.trackParams(p, { params: { area: currentArea } }) : null;
            window.sokunobankTrackOutboundClick(
              Object.assign(
                {
                  destination: "yahoo_shopping",
                  category: slug,
                  brand: p.brand || undefined,
                  product_name: p.name || undefined,
                  price: p.price,
                  delivery_label: deliveryLabel(p.deliveryDay),
                  page_path: window.location.pathname,
                  link_url: a.href,
                  // カード全体が1つの<a>のため、a.textContentだと画像alt以外の全テキストが
                  // 混ざってしまう。CTA文言(視認上のリンクラベルに相当するもの)に固定する。
                  link_text: "Yahoo!ショッピングで納期を確認",
                  position: index,
                },
                extra || {}
              )
            );
          });
        }
      });

      const badge = document.createElement("span");
      badge.className = "urgent-card-badge";
      badge.textContent = deliveryLabelFor(p);
      a.appendChild(badge);

      const img = document.createElement("img");
      img.className = "urgent-card-image";
      img.src = p.image;
      img.alt = p.name;
      img.loading = "lazy";
      img.width = 160;
      img.height = 160;
      a.appendChild(img);

      const name = document.createElement("p");
      name.className = "urgent-card-name";
      name.textContent = p.name;
      a.appendChild(name);

      const power = extractPowerSpec(p.name);
      if (power) {
        const powerEl = document.createElement("p");
        powerEl.className = "urgent-card-power";
        powerEl.textContent = `出力目安 ${power}`;
        a.appendChild(powerEl);
      }

      const price = document.createElement("p");
      price.className = "urgent-card-price";
      price.textContent = `${p.price.toLocaleString()}円`;
      a.appendChild(price);

      const cta = document.createElement("span");
      cta.className = "urgent-card-cta";
      cta.textContent = "Yahoo!ショッピングで納期を確認 →";
      a.appendChild(cta);

      li.appendChild(a);
      return li;
    }

    let latestRequestId = 0;
    async function load(areaOverride) {
      const requestId = ++latestRequestId;
      setState("loading");
      let area = "";
      if (areaOverride !== undefined) {
        area = areaOverride;
      } else {
        try {
          area = window.localStorage.getItem(`sokunobank:commerce:${slug}:area`) || "";
        } catch {
          // no-op
        }
      }
      currentArea = area;
      const query = new URLSearchParams();
      if (area) query.set("area", area);
      query.set("sort", "recommended");
      try {
        const res = await fetch(`${apiPath}?${query.toString()}`);
        const data = await res.json();
        if (requestId !== latestRequestId) return;
        if (data.error || !data.products || data.products.length === 0) {
          setState("empty");
          return;
        }
        listEl.innerHTML = "";
        data.products.slice(0, MAX_ITEMS).forEach((p, i) => listEl.appendChild(createCard(p, i)));
        setState("list");
      } catch {
        if (requestId !== latestRequestId) return;
        setState("empty");
      }
    }

    load();
    // お届け先が変更されたとき(上のSTEP選択、または商品一覧の絞り込みパネル)に再取得する。
    document.addEventListener("commerce:filter-change", (event) => {
      if (!event.detail || event.detail.slug !== slug) return;
      const nextArea = (event.detail.params && event.detail.params.area) || "";
      if (nextArea !== currentArea) load(nextArea);
    });
  })();
</script>

<style is:global>
  .urgent-section {
    margin: 2rem 0;
  }
  .urgent-heading h2 {
    margin: 0 0 0.3rem;
  }
  .urgent-heading p {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  .urgent-state {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .urgent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .urgent-list[hidden] {
    display: none;
  }
  .urgent-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg);
  }
  .urgent-card-link {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1rem 1.1rem;
    text-decoration: none;
    color: var(--color-text);
    height: 100%;
  }
  .urgent-card-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-urgent-text);
    background: var(--color-urgent-soft);
    border: 1px solid var(--color-urgent);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-bottom: 0.55rem;
  }
  .urgent-card-image {
    width: 100%;
    height: 140px;
    object-fit: contain;
    background: var(--color-bg-soft);
    border-radius: var(--radius-sm);
    margin-bottom: 0.55rem;
  }
  .urgent-card-name {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.4;
    min-height: calc(1.4em * 2);
    margin: 0 0 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .urgent-card-power {
    font-size: 0.78rem;
    color: var(--color-accent-dark);
    font-weight: 600;
    margin: 0 0 0.2rem;
  }
  .urgent-card-price {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
  }
  .urgent-card-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.85rem;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .urgent-list {
      grid-auto-flow: column;
      grid-auto-columns: minmax(180px, 70%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.4rem;
    }
    .urgent-card {
      scroll-snap-align: start;
    }
  }
</style>
