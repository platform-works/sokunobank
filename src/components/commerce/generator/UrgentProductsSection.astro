---
// 「選んだ条件のおすすめ商品」セクション(2026-09-28導入、2026-10-24にレビュー優先へ変更)。発電機カテゴリー専用。
// 既存のAPI(/api/generator/products/)をそのまま使い、取得済みの商品から、STEP選択に合うもののうち
// Yahoo!ショッピングのレビュー評価・件数が最も高い1件を表示する(選定ロジックは lib/commerce/reviewPick.ts)。
// ProductGrid.astro(全商品一覧、既存・未変更)とは別のクライアントスクリプトで、同じAPIエンドポイントに
// 対して独立してfetchする(商品取得ロジック・Yahoo APIの呼び出し方は一切変更していない)。
interface Props {
  slug: string;
  apiPath: string;
}
const { slug, apiPath } = Astro.props;
const rootId = `generator-urgent-${slug}`;
---

<section class="urgent-section" id="urgent">
  <div class="urgent-heading">
    <h2>選んだ条件のおすすめ商品</h2>
    <p>
      上で選んだ種類・容量・出力・用途に合う商品のうち、レビュー評価と件数が高い商品を表示します。Yahoo!ショッピングのレビューを基本に、同じ型番で価格帯の近い商品は他の通販サイトの評価も参考にしています。評価は件数が少ないほど割り引いて比べています(カードに表示する評価はYahoo!ショッピングのものです)。
    </p>
    <p class="urgent-points">
      毎月5・15・25日の「5のつく日」は、PayPayポイントが5倍になる特典の対象日です(付与条件・上限はYahoo!ショッピングの案内でご確認ください)。
      <strong data-gotsuku-today hidden>本日は5のつく日です。</strong>
    </p>
  </div>
  <div class="urgent-grid" id={rootId} data-urgent-root data-slug={slug} data-api-path={apiPath}>
    <p class="urgent-state urgent-loading" data-role="loading">商品情報を取得しています…</p>
    <p class="urgent-state urgent-empty" data-role="empty" hidden>
      現在ピックアップできる商品がありません。下の商品一覧からお探しください。
    </p>
    <ul class="urgent-list" data-role="list" hidden></ul>
  </div>
</section>

<script>
  // 「選んだ条件のおすすめ商品」(2026-10-24、ユーザー指示で納期優先からレビュー優先に変更)。
  // 取得済みの商品のうち、STEP選択(種類・容量・出力・用途)に合うものから、Yahoo!ショッピングの
  // レビュー評価・件数(件数補正済み)が最も高い1件を表示する。納期・報酬額は選定に使わない
  // (配送の目安は補足表示のみ)。選択の絞り込みは商品一覧と同じ純関数(filterBySelection)を使う。
  import { filterBySelection, getSelection, isFiltering, specsOf, typeLabels } from "../../../lib/commerce/generatorClient";
  import { adjustedRating, isGotsukuDay, pickByReview } from "../../../lib/commerce/reviewPick";
  import { amazonJanUrl, amazonKeywordUrl } from "../../../lib/commerce/amazonLink";

  interface PickProduct {
    name: string;
    image: string;
    price: number;
    brand: string | null;
    productUrl: string;
    deliveryDay: number | null;
    reviewRate: number;
    reviewCount: number;
    reviewSignal?: number;
    janCode?: string;
    description?: string;
    storeName?: string;
  }

  const root = document.querySelector<HTMLElement>("[data-urgent-root]");
  if (root) {
    const slug = root.dataset.slug || "";
    const apiPath = root.dataset.apiPath || "";
    const loadingEl = root.querySelector<HTMLElement>('[data-role="loading"]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-role="empty"]')!;
    const listEl = root.querySelector<HTMLElement>('[data-role="list"]')!;
    const MAX_ITEMS = 1;

    type W = Window & { sokunobankCardExtensions?: Record<string, any>; sokunobankDebounceClick?: any; sokunobankTrackOutboundClick?: any };
    const w = window as W;
    const getExt = () => (w.sokunobankCardExtensions ? w.sokunobankCardExtensions.generator : undefined);

    let currentArea = "";
    let allProducts: PickProduct[] = [];

    function setState(state: "loading" | "empty" | "list") {
      loadingEl.hidden = state !== "loading";
      emptyEl.hidden = state !== "empty";
      listEl.hidden = state !== "list";
    }

    // 配送の目安(補足)。お届け先が分かるときだけ「東京都宛て:明日お届け対象」形式、分からなければ確認を促す
    function deliveryNote(p: PickProduct): string {
      const ext = getExt();
      const text = ext && ext.deliveryText ? ext.deliveryText(p, { params: { area: currentArea } }) : null;
      if (text) return text;
      if (p.deliveryDay === 1) return "明日到着対象";
      if (p.deliveryDay === 2) return "翌々日到着対象";
      return "配送日は商品ページでご確認ください";
    }

    // 右側の「この商品について」。確認できる事実(商品名から読み取れる容量・出力、レビュー、価格、配送の目安、ストア)と、
    // 出品者の商品説明(抜粋。文章として読めるものがある場合のみ)を出す。説明は出品者の記載でサイトは保証しない。
    function createDetail(p: PickProduct) {
      const d = document.createElement("div");
      d.className = "urgent-detail";
      const h = document.createElement("h3");
      h.textContent = "この商品について";
      d.appendChild(h);

      const s = specsOf(p);
      const facts: [string, string][] = [];
      if (s.productType) facts.push(["種類", s.productType === "portable" ? "ポータブル電源(バッテリー式)" : s.productType === "gasoline" ? "ガソリン発電機" : "カセットガス発電機"]);
      if (p.brand) facts.push(["ブランド", p.brand]);
      if (s.capacityWh !== null) facts.push(["容量", `${s.capacityWh.toLocaleString("en-US")}Wh`]);
      if (s.outputLabel !== null) facts.push(["定格出力", s.outputLabel]);
      facts.push(["価格", `${p.price.toLocaleString()}円`]);
      facts.push(["レビュー", `Yahoo!ショッピング ${p.reviewRate.toFixed(2)}(${p.reviewCount.toLocaleString()}件)`]);
      if (p.storeName) facts.push(["販売ストア", p.storeName]);
      facts.push(["配送の目安", deliveryNote(p)]);
      const dl = document.createElement("dl");
      dl.className = "urgent-facts";
      for (const [k, v] of facts) {
        const dt = document.createElement("dt");
        dt.textContent = k;
        const dd = document.createElement("dd");
        dd.textContent = v;
        dl.append(dt, dd);
      }
      d.appendChild(dl);

      if (p.description) {
        const desc = document.createElement("p");
        desc.className = "urgent-desc";
        desc.textContent = p.description;
        const cap = document.createElement("p");
        cap.className = "urgent-desc-caption";
        cap.textContent = "出品者の商品説明より(抜粋)";
        d.append(cap, desc);
      }
      const note = document.createElement("p");
      note.className = "urgent-detail-note";
      note.textContent = "容量・出力は商品名の表記から読み取った値です。在庫・配送・仕様の詳細は商品ページで確認してください。";
      d.appendChild(note);
      return d;
    }

    function createCard(p: PickProduct, index: number) {
      // PCは「左:商品カード(画像大きめ)/右:商品の説明」の2列、スマホは縦並び
      const li = document.createElement("li");
      li.className = "urgent-feature";
      const main = document.createElement("div");
      main.className = "urgent-card";
      li.appendChild(main);

      const a = document.createElement("a");
      a.className = "urgent-card-link";
      a.href = p.productUrl;
      a.target = "_blank";
      a.rel = "sponsored noopener";
      a.addEventListener("click", () => {
        // 既存のoutbound_product_click計測をそのまま使う(新イベントは作らない)
        if (w.sokunobankDebounceClick && w.sokunobankTrackOutboundClick) {
          w.sokunobankDebounceClick(a, () => {
            const ext = getExt();
            const extra = ext && ext.trackParams ? ext.trackParams(p, { params: { area: currentArea } }) : null;
            w.sokunobankTrackOutboundClick(
              Object.assign(
                {
                  destination: "yahoo_shopping",
                  category: slug,
                  brand: p.brand || undefined,
                  product_name: p.name || undefined,
                  price: p.price,
                  delivery_label: deliveryNote(p),
                  page_path: window.location.pathname,
                  link_url: a.href,
                  link_text: "Yahoo!ショッピングで確認",
                  position: index,
                },
                extra || {}
              )
            );
          });
        }
      });

      const badge = document.createElement("span");
      badge.className = "urgent-card-badge";
      badge.textContent = "レビュー評価が高い";
      a.appendChild(badge);

      const img = document.createElement("img");
      img.className = "urgent-card-image";
      img.src = p.image;
      img.alt = p.name;
      img.loading = "lazy";
      img.width = 160;
      img.height = 160;
      a.appendChild(img);

      const name = document.createElement("p");
      name.className = "urgent-card-name";
      name.textContent = p.name;
      a.appendChild(name);

      const review = document.createElement("p");
      review.className = "urgent-card-review";
      review.textContent = `Yahoo!ショッピングのレビュー ${p.reviewRate.toFixed(2)}(${p.reviewCount.toLocaleString()}件)`;
      review.title = `件数補正後の評価 ${adjustedRating(p.reviewRate, p.reviewCount).toFixed(2)}`;
      a.appendChild(review);

      const price = document.createElement("p");
      price.className = "urgent-card-price";
      price.textContent = `${p.price.toLocaleString()}円`;
      a.appendChild(price);

      const note = document.createElement("p");
      note.className = "urgent-card-delivery";
      note.textContent = deliveryNote(p);
      a.appendChild(note);

      const cta = document.createElement("span");
      cta.className = "urgent-card-cta";
      cta.textContent = "Yahoo!ショッピングで確認 →";
      a.appendChild(cta);

      main.appendChild(a);

      // Yahoo!ボタンの下にAmazonへのリンク(カード全体が1つの<a>のため、リンクの外に置く)。
      // JANがあれば「AmazonでJAN検索」、無ければブランド名+種類での検索。どちらも検索結果ページへのリンクのみ
      const productType = specsOf(p).productType;
      const typeWord = productType === "portable" ? typeLabels.portable : productType ? "発電機" : "";
      const janUrl = amazonJanUrl(p.janCode);
      const keywordUrl = !janUrl && p.brand && typeWord ? amazonKeywordUrl(`${p.brand} ${typeWord}`) : null;
      const amazonUrl = janUrl || keywordUrl;
      const amazonKind = janUrl ? "amazon_jan" : "amazon_keyword";
      const amazonLabel = janUrl ? "AmazonでJAN検索" : `Amazonで${p.brand}の${typeWord}を探す`;
      if (amazonUrl) {
        const wrap = document.createElement("div");
        wrap.className = "urgent-amazon";
        const am = document.createElement("a");
        am.className = "btn btn-secondary urgent-amazon-btn";
        am.href = amazonUrl;
        am.target = "_blank";
        am.rel = "sponsored noopener";
        am.textContent = `${amazonLabel} →`;
        am.addEventListener("click", () => {
          if (w.sokunobankDebounceClick) {
            w.sokunobankDebounceClick(am, () => {
              (window as any).sokunobankTrackEvent?.("generator_usage_outbound", {
                category: slug,
                value: amazonKind,
                link_type: amazonKind,
                link_url: am.href,
                link_text: amazonLabel,
                page_path: window.location.pathname,
              });
            });
          }
        });
        const note = document.createElement("p");
        note.className = "urgent-amazon-note";
        note.textContent = janUrl ? "PR・同じ商品の出品は保証されません" : "PR・同じ商品の出品は保証されません(ブランドでの検索結果です)";
        wrap.append(am, note);
        main.appendChild(wrap);
      }

      li.appendChild(createDetail(p));
      return li;
    }

    function render() {
      const sel = getSelection();
      const { visible } = filterBySelection(allProducts, sel);
      const picks = pickByReview(visible, MAX_ITEMS);
      if (picks.length === 0) {
        emptyEl.textContent = isFiltering(sel)
          ? "選んだ条件に合い、レビューが十分にある商品を、取得済みの商品の中から見つけられませんでした。下の商品一覧もご確認ください。"
          : "現在ピックアップできる商品がありません。下の商品一覧からお探しください。";
        setState("empty");
        return;
      }
      listEl.innerHTML = "";
      picks.forEach((p, i) => listEl.appendChild(createCard(p, i)));
      setState("list");
    }

    let latestRequestId = 0;
    async function load(areaOverride?: string) {
      const requestId = ++latestRequestId;
      setState("loading");
      let area = "";
      if (areaOverride !== undefined) {
        area = areaOverride;
      } else {
        try {
          area = window.localStorage.getItem(`sokunobank:commerce:${slug}:area`) || "";
        } catch {
          // no-op
        }
      }
      currentArea = area;
      const query = new URLSearchParams();
      if (area) query.set("area", area);
      query.set("sort", "recommended");
      try {
        const res = await fetch(`${apiPath}?${query.toString()}`);
        const data = await res.json();
        if (requestId !== latestRequestId) return;
        if (data.error || !data.products || data.products.length === 0) {
          allProducts = [];
          emptyEl.textContent = "現在ピックアップできる商品がありません。下の商品一覧からお探しください。";
          setState("empty");
          return;
        }
        allProducts = data.products;
        render();
      } catch {
        if (requestId !== latestRequestId) return;
        allProducts = [];
        setState("empty");
      }
    }

    load();
    // お届け先が変わったら再取得、STEP選択(種類・容量・出力・用途)が変わったら取得済みの商品から選び直す
    document.addEventListener("commerce:filter-change", (event) => {
      const detail = (event as CustomEvent).detail;
      if (!detail || detail.slug !== slug) return;
      const nextArea = (detail.params && detail.params.area) || "";
      if (nextArea !== currentArea) load(nextArea);
    });
    document.addEventListener("generator:selection-change", () => {
      if (allProducts.length > 0) render();
    });

    // 「5のつく日」(5・15・25日)の当日だけ、案内に強調表示を出す
    const gotsuku = document.querySelector<HTMLElement>("[data-gotsuku-today]");
    if (gotsuku && isGotsukuDay()) gotsuku.hidden = false;
  }
</script>

<style is:global>
  .urgent-section {
    margin: 2rem 0;
  }
  .urgent-heading h2 {
    margin: 0 0 0.3rem;
  }
  .urgent-heading p {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  .urgent-state {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .urgent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: block;
  }
  /* PC: 左に商品カード(画像大きめ)、右に商品の説明。1件だけ表示するため、カードを横に引き伸ばさない */
  .urgent-feature {
    display: grid;
    grid-template-columns: minmax(300px, 380px) 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .urgent-detail {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    padding: 1.1rem 1.3rem;
  }
  .urgent-detail h3 {
    margin: 0 0 0.7rem;
    font-size: 1.05rem;
  }
  .urgent-facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1rem;
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
  }
  .urgent-facts dt {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .urgent-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .urgent-desc-caption {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .urgent-desc {
    margin: 0 0 0.8rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .urgent-detail-note {
    margin: 0;
    font-size: 0.76rem;
    color: var(--color-text-muted);
  }
  .urgent-list[hidden] {
    display: none;
  }
  .urgent-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg);
  }
  .urgent-card-link {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1rem 1.1rem;
    text-decoration: none;
    color: var(--color-text);
    height: 100%;
  }
  .urgent-card-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-urgent-text);
    background: var(--color-urgent-soft);
    border: 1px solid var(--color-urgent);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-bottom: 0.55rem;
  }
  .urgent-card-image {
    width: 100%;
    height: 300px;
    object-fit: contain;
    background: var(--color-bg-soft);
    border-radius: var(--radius-sm);
    margin-bottom: 0.55rem;
  }
  .urgent-card-name {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.4;
    min-height: calc(1.4em * 2);
    margin: 0 0 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .urgent-card-review {
    font-size: 0.8rem;
    color: var(--color-accent-dark);
    font-weight: 600;
    margin: 0 0 0.2rem;
  }
  .urgent-card-delivery {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
  }
  .urgent-amazon {
    padding: 0 1rem 1rem;
  }
  .urgent-amazon-btn {
    width: 100%;
    height: 40px;
    font-size: 0.82rem;
  }
  .urgent-amazon-note {
    margin: 0.25rem 0 0;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .urgent-points {
    font-size: 0.82rem;
  }
  .urgent-card-price {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
  }
  .urgent-card-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.85rem;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .urgent-feature {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .urgent-card-image {
      height: 200px;
    }
  }
</style>
