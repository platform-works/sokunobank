---
// 商品カード拡張(ブランド・容量・定格出力など・配送の固定案内・GA4パラメータ)を
// ProductGrid.astro の拡張ポイント(variant=slug)へ登録する。ページに1回だけ置く(2026-10-24にカテゴリー共通化)。
// 登録処理本体は src/lib/commerce/appliance/createApplianceClient.ts(テスト済みの純関数を含む)。
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<div data-appliance-runtime={slug} hidden></div>

<script>
  import { getApplianceClient } from "../../../lib/commerce/appliance/clients";
  const el = document.querySelector<HTMLElement>("[data-appliance-runtime]");
  if (el) getApplianceClient(el.dataset.applianceRuntime ?? "").registerExtension();
</script>

<style is:global>
  /* ProductGridがJSで動的に生成するカードに追加される要素のスタイル */
  .gen-card-brand {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    margin: 0;
  }
  .gen-card-spec {
    font-size: 0.8rem;
    color: var(--color-text);
    margin: 0;
  }
  .gen-amazon {
    margin-top: 0.5rem;
  }
  .gen-amazon-btn {
    width: 100%;
    height: 40px;
    font-size: 0.82rem;
  }
  .gen-amazon-note {
    margin: 0.25rem 0 0;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .gen-filter-reset {
    height: 36px;
    margin-left: 0.4rem;
    font-size: 0.8rem;
    vertical-align: middle;
  }
  .gen-filter-note {
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.7rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--color-text);
  }
</style>
