---
// スマホ幅(720px以下)だけ折りたたむセクションラッパー(2026-09-30導入)。
// 目的: スマホで商品一覧までのスクロール量を減らす。PC(721px以上)では常に開いたまま・見出しバー非表示で
// 従来どおり。サーバー側では常に <details open> で出力するため、初期HTMLに本文が含まれ
// (Googlebot/JS無効環境でも全文が読める)、モバイル幅の場合だけ index.astro のインラインスクリプトが
// ペイント前に open を外す(PickupBrandSection.astro・絞り込みパネルと同じ確立済みパターン)。
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<details class="fold" open>
  <summary class="fold-summary">{label}</summary>
  <slot />
</details>

<style>
  .fold-summary {
    display: none;
  }
  @media (max-width: 720px) {
    .fold {
      margin: 0.75rem 0;
    }
    .fold-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      padding: 0 1rem;
      border: 1px solid var(--color-accent);
      border-radius: var(--radius-md);
      background: var(--color-accent-soft);
      color: var(--color-accent-dark);
      font-weight: 700;
      font-size: 0.92rem;
      cursor: pointer;
      list-style: none;
    }
    .fold-summary::-webkit-details-marker {
      display: none;
    }
    .fold[open] > .fold-summary::after {
      content: "▲";
    }
    .fold:not([open]) > .fold-summary::after {
      content: "▼";
    }
  }
</style>
