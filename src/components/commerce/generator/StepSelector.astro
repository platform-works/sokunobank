---
// 「何を買うか決める」ステップ選択(2026-09-30導入、2026-10-24にカテゴリー共通化)。
// 用途 → 種類 → 容量/出力 → 予算 → ブランド → 商品一覧。カテゴリー固有の値と文言は
// src/lib/commerce/appliance/profiles/<slug>.ts(ApplianceProfile)から受け取り、絞り込みの処理は
// 共通エンジン(createApplianceClient.ts)が行う。商品名から確認できない商品は推測で分類しない。
// 用途は商品の属性ではないため、商品名に用途を示す語が明記された商品だけを対象にする。
import { getApplianceProfile } from "../../../lib/commerce/appliance/clients";

interface Props {
  slug: string;
  heading?: string;
}
const { slug, heading = "用途・容量・予算から、買う商品を絞り込む" } = Astro.props;
const profile = getApplianceProfile(slug);
const types = Object.entries(profile.typeLabels);
const hasPower = profile.powerBands.length > 0;
// STEPの番号は、実際に出す行の順に振る
let stepCount = 0;
const stepNo = () => `STEP${++stepCount}`;
const noteTypes = profile.notes.filter((n) => n.row === "type");
const noteSpecs = profile.notes.filter((n) => n.row === "spec");
const noteClass = (v: string) => (v === "hint" ? "step-hint" : "step-note");
---

<section class="step-selector" id="step" aria-labelledby="step-heading" data-slug={slug}>
  <div class="step-head">
    <h2 id="step-heading">{heading}</h2>
  </div>

  <div class="step-row">
    <p class="step-label"><span class="step-no">{stepNo()}</span>{profile.text.stepUseCase}</p>
    <div class="step-options" role="group" aria-label="用途">
      {
        profile.useCases.map((u) => (
          <button type="button" class="step-option" aria-pressed="false" data-kind="usecase" data-value={u.id} data-label={u.label}>
            {u.label}
          </button>
        ))
      }
    </div>
    <p class="step-hint" data-role="usecase-hint" hidden></p>
    <div class="step-reco" data-role="usecase-reco" aria-live="polite" hidden></div>
  </div>

  {
    types.length > 0 && (
      <div class="step-row">
        <p class="step-label"><span class="step-no">{stepNo()}</span>{profile.text.stepType}</p>
        <div class="step-options" role="group" aria-label="種類">
          {types.map(([value, label]) => (
            <button type="button" class="step-option" aria-pressed="false" data-kind="type" data-value={value} data-label={label}>
              {label}
            </button>
          ))}
        </div>
        {noteTypes.map((n) => (
          <p class={noteClass(n.variant)} data-note-id={n.id} hidden>{n.text}</p>
        ))}
      </div>
    )
  }

  <div class="step-row">
    <p class="step-label"><span class="step-no">{stepNo()}</span>{profile.text.stepSpec}</p>
    <div class="step-options" role="group" aria-label={profile.text.capacityGroupAria}>
      {hasPower && <span class="step-group-label">{profile.text.capacityGroupLabel}</span>}
      {
        profile.capacityBands.map((b, i) => (
          <button type="button" class="step-option" aria-pressed="false" data-kind="capacity" data-value={String(i)} data-label={b.label}>
            {b.label}
          </button>
        ))
      }
    </div>
    {
      hasPower && (
        <div class="step-options" role="group" aria-label={profile.text.powerGroupAria}>
          <span class="step-group-label">{profile.text.powerGroupLabel}</span>
          {profile.powerBands.map((b, i) => (
            <button type="button" class="step-option" aria-pressed="false" data-kind="power" data-value={String(i)} data-label={b.label}>
              {b.label}
            </button>
          ))}
        </div>
      )
    }
    {noteSpecs.map((n) => <p class={noteClass(n.variant)} data-note-id={n.id} hidden>{n.text}</p>)}
    <p class="step-note" set:html={profile.text.specRowNote} />
    <slot name="spec-extra" />
  </div>

  <div class="step-row">
    <p class="step-label"><span class="step-no">{stepNo()}</span>{profile.text.stepBudget}</p>
    <div class="step-options" role="group" aria-label="予算">
      {
        profile.budgetBands.map((b, i) => (
          <button type="button" class="step-option" aria-pressed="false" data-kind="budget" data-value={String(i)} data-label={b.label}>
            {b.label}
          </button>
        ))
      }
    </div>
    <p class="step-note">予算は商品の表示価格(円)で絞り込みます。送料・ポイント還元は含みません。</p>
  </div>

  <div class="step-row">
    <p class="step-label"><span class="step-no">{stepNo()}</span>{profile.text.stepBrand}</p>
    <div class="step-options" role="group" aria-label="ブランド">
      {
        profile.brandOptions.map((b) => (
          <button type="button" class="step-option" aria-pressed="false" data-kind="brand" data-value={b.id} data-label={b.label}>
            {b.label}
          </button>
        ))
      }
    </div>
    <p class="step-note">ブランドは、商品名・ブランド名の表記で絞り込みます。</p>
  </div>

  <div class="step-row step-go-row">
    <p class="step-label"><span class="step-no">{stepNo()}</span>条件に合う商品を見る</p>
    <a class="btn btn-primary btn-lg step-go" href="#products" data-role="go">
      条件に合う商品を見る <span data-role="count"></span>
    </a>
  </div>
</section>

<script>
  import { getApplianceClient } from "../../../lib/commerce/appliance/clients";

  const root = document.getElementById("step");
  if (root) {
    const client = getApplianceClient(root.dataset.slug ?? "");
    const profile = client.profile;
    const hints = Object.fromEntries(profile.useCases.filter((u) => u.note).map((u) => [u.id, u.note as string]));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>(".step-option"));
    const hintEl = root.querySelector<HTMLElement>('[data-role="usecase-hint"]');
    const recoEl = root.querySelector<HTMLElement>('[data-role="usecase-reco"]');
    const noteEls = Array.from(root.querySelectorAll<HTMLElement>("[data-note-id]"));
    const countEl = root.querySelector<HTMLElement>('[data-role="count"]');
    const goLink = root.querySelector<HTMLAnchorElement>('[data-role="go"]');
    const { setSelection, trackFilterUse, getSelection } = client;

    const extraApi = {
      setSelection,
      trackFilterUse,
      scrollToProducts: () => document.getElementById("products")?.scrollIntoView({ behavior: "smooth", block: "start" }),
    };

    // 用途だけを選んだ人に、その用途の追加表示(おすすめ容量・計算ツールなど。カテゴリーごとに定義)を出す。
    // 用途が変わったときだけ作り直す(他の選択変更では触らない)
    let extraFor: string | null | undefined;
    function renderExtra(useCase: string | null) {
      if (!recoEl || extraFor === useCase) return;
      extraFor = useCase;
      recoEl.textContent = "";
      const extra = useCase && profile.useCaseExtra ? profile.useCaseExtra(useCase, extraApi) : null;
      if (!extra) {
        recoEl.hidden = true;
        return;
      }
      recoEl.appendChild(extra);
      recoEl.hidden = false;
    }

    function render() {
      const sel = getSelection();
      for (const b of buttons) {
        const kind = b.dataset.kind;
        const value = b.dataset.value ?? "";
        let pressed = false;
        if (kind === "usecase") pressed = sel.useCase === value;
        else if (kind === "type") pressed = sel.type === value;
        else if (kind === "capacity") pressed = sel.capacity !== null && sel.capacity.label === profile.capacityBands[Number(value)].label;
        else if (kind === "power") pressed = sel.power !== null && sel.power.label === profile.powerBands[Number(value)].label;
        else if (kind === "budget") pressed = sel.budget !== null && sel.budget.label === profile.budgetBands[Number(value)].label;
        else if (kind === "brand") pressed = sel.brand !== null && sel.brand.id === value;
        b.setAttribute("aria-pressed", String(pressed));
        // 容量を商品名から確認できない種類(発電機のエンジン式)では、容量ボタンを選べなくする(選ぶと必ず0件になるため)
        if (kind === "capacity") b.disabled = client.isNoCapacityType(sel.type);
        // 用途によって選べない種類(発電機の車中泊でのエンジン式)は選べなくする
        if (kind === "type") b.disabled = client.isTypeBlocked(sel.useCase, value);
      }
      for (const el of noteEls) {
        const note = profile.notes.find((n) => n.id === el.dataset.noteId);
        el.hidden = !note || !note.when(sel);
      }
      renderExtra(sel.useCase);
      if (hintEl) {
        const text = sel.useCase ? hints[sel.useCase] : undefined;
        hintEl.hidden = !text;
        hintEl.textContent = text ?? "";
      }
    }

    root.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>(".step-option");
      if (!target) return;
      const kind = target.dataset.kind;
      const value = target.dataset.value ?? "";
      const label = target.dataset.label ?? "";
      const pressed = target.getAttribute("aria-pressed") === "true";
      if (kind === "usecase") {
        setSelection({ useCase: pressed ? null : value });
        trackFilterUse("use_case", pressed ? undefined : label);
      } else if (kind === "type") {
        setSelection({ type: pressed ? null : value });
        trackFilterUse("product_type", pressed ? undefined : label);
      } else if (kind === "capacity") {
        setSelection({ capacity: pressed ? null : profile.capacityBands[Number(value)] });
        trackFilterUse("capacity_band", pressed ? undefined : label);
      } else if (kind === "power") {
        setSelection({ power: pressed ? null : profile.powerBands[Number(value)] });
        trackFilterUse("power_band", pressed ? undefined : label);
      } else if (kind === "brand") {
        setSelection({ brand: pressed ? null : (profile.brandOptions.find((b) => b.id === value) ?? null) });
        trackFilterUse("brand", pressed ? undefined : label);
      } else if (kind === "budget") {
        setSelection({ budget: pressed ? null : profile.budgetBands[Number(value)] });
        trackFilterUse("budget", pressed ? undefined : label);
      }
    });

    // ページ内の他セクション(用途別カード等)から用途を設定するためのフック
    document.addEventListener("click", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>("[data-set-usecase]");
      if (!el) return;
      const id = el.dataset.setUsecase ?? "";
      setSelection({ useCase: id });
      trackFilterUse("use_case", el.dataset.label ?? id);
    });

    document.addEventListener(client.EVENT_CHANGE, render);
    render();

    // リスティング広告などからのリンク(?brand=jackery&type=portable 等)で、条件を選んだ状態にする
    const fromUrl = client.selectionFromParams(new URLSearchParams(window.location.search));
    if (Object.keys(fromUrl).length > 0) setSelection(fromUrl);

    document.addEventListener(client.EVENT_RESULT, (event) => {
      const d = (event as CustomEvent).detail as { shown: number; filtering: boolean };
      if (countEl) countEl.textContent = d.filtering ? `(該当${d.shown}件)` : "";
    });

    goLink?.addEventListener("click", () => {
      const sel = getSelection();
      const parts = [sel.type, sel.capacity?.label, sel.power?.label, sel.budget?.label].filter(Boolean);
      trackFilterUse("step_confirm", parts.length > 0 ? parts.join(" / ") : "条件なし");
    });
  }
</script>

<style>
  .step-selector {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.4rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .step-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .step-head h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .step-area {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .step-area select {
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0 0.7rem;
    background: var(--color-bg);
    font-size: 0.92rem;
    color: var(--color-text);
  }
  .step-row {
    padding: 0.7rem 0;
    border-top: 1px solid var(--color-border);
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
    font-weight: 700;
  }
  .step-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    padding: 0 0.55rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .step-options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .step-group-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 2.2rem;
  }
  .step-option {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }
  .step-option:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .step-option:hover:not(:disabled) {
    border-color: var(--color-accent);
  }
  .step-option[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .step-option:focus-visible,
  .step-go:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .step-hint {
    margin: 0.4rem 0 0;
    padding: 0.6rem 0.9rem;
    background: var(--color-warn-bg);
    border: 1px solid var(--color-warn-border);
    border-radius: var(--radius-md);
    font-size: 0.84rem;
  }
  .step-note {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .step-go-row .step-go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .step-selector {
      padding: 1rem;
    }
    .step-go {
      width: 100%;
    }
  }
</style>

<style is:global>
  /* 用途を選んだあとにJSで作る「おすすめ容量」「機器から計算」の要素(スコープ付きCSSは動的要素に効かないためグローバル) */
  .step-reco {
    margin: 0.5rem 0 0;
    padding: 0.8rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .step-reco-title {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .step-reco-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .step-reco-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }
  .step-reco-desc,
  .step-reco-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .step-reco-note {
    margin: 0.5rem 0 0;
  }
  .step-calc {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--color-border);
  }
  .step-calc-rows {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .step-calc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .step-calc-row input[type="checkbox"] {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .step-calc-name {
    flex: 1 1 12rem;
    font-size: 0.86rem;
    font-weight: 600;
  }
  .step-calc-name small {
    display: block;
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .step-calc-unit {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .step-calc-num,
  .step-calc-text {
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0 0.5rem;
    font-size: 0.92rem;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .step-calc-text {
    width: 100%;
  }
  .step-calc-result {
    margin-top: 0.8rem;
  }
  .step-calc-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .step-calc-buttons [hidden] {
    display: none;
  }
  .step-calc-out {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
  }
</style>
