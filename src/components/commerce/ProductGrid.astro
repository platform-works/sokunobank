---
interface Props {
  slug: string;
  apiPath: string;
}
const { slug, apiPath } = Astro.props;
const rootId = `commerce-grid-${slug}`;
---

<div class="commerce-grid" id={rootId} data-api-path={apiPath}>
  <p class="state state-loading" data-role="loading">商品情報を取得しています…</p>
  <p class="state state-error" data-role="error" hidden>
    現在商品情報を取得できません。時間をおいて再度お試しください。
  </p>
  <p class="state state-empty" data-role="empty" hidden>
    条件に合う商品が見つかりませんでした。到着希望や価格条件を緩めてお試しください。
  </p>
  <ul class="product-list" data-role="list" hidden></ul>
  <div class="scroll-sentinel" data-role="sentinel" hidden></div>
</div>

<script define:vars={{ rootId, slug }}>
  // このscriptタグは自分のマークアップ(id={rootId}のdiv)より後にDOMへ出力されるため、
  // getElementById等はDOMContentLoadedを待たずに即実行できる。むしろCommerceFilterPanel側は
  // 初期状態をDOMContentLoaded後にイベント発火するため、ここでの購読(addEventListener)は
  // DOMContentLoadedを待たず即座に済ませる必要がある(待つと購読前に発火されて取りこぼす)。
  (function () {
    const root = document.getElementById(rootId);
    if (!root) return;
    const apiPath = root.dataset.apiPath;
    const loadingEl = root.querySelector('[data-role="loading"]');
    const errorEl = root.querySelector('[data-role="error"]');
    const emptyEl = root.querySelector('[data-role="empty"]');
    const listEl = root.querySelector('[data-role="list"]');
    const sentinelEl = root.querySelector('[data-role="sentinel"]');
    const PAGE_SIZE = 40;

    function setState(state) {
      loadingEl.hidden = state !== "loading";
      errorEl.hidden = state !== "error";
      emptyEl.hidden = state !== "empty";
      listEl.hidden = state !== "list";
      if (state !== "list") {
        scrollObserver.unobserve(sentinelEl);
        sentinelEl.hidden = true;
      }
    }

    function deliveryLabel(day) {
      // 当日到着(day=0)は現実的に成立しづらいため、表示上は約束しない(day=0もday=nullと同様の扱いにする)。
      if (day === 1) return "明日到着対象";
      if (day === 2) return "翌々日到着対象";
      return "配送日は商品ページでご確認ください";
    }

    // 将来アナリティクスを配線する際の差し込み口。現状は外部サービスを追加しないため no-op。
    function trackEvent(name, params) {
      if (window.sokunobankTrackEvent) window.sokunobankTrackEvent(name, params);
    }

    function makeLink(p, index, extraClass) {
      const a = document.createElement("a");
      a.className = extraClass;
      a.href = p.affiliateUrl;
      a.target = "_blank";
      a.rel = "sponsored noopener";
      a.addEventListener("click", () => {
        trackEvent("projector_product_click", {
          productCode: p.code,
          rank: index + 1,
          price: p.price,
        });
      });
      return a;
    }

    function createCard(p, index) {
      const li = document.createElement("li");
      li.className = "product-card";

      const imgLink = makeLink(p, index, "product-image-link");
      const img = document.createElement("img");
      img.src = p.image;
      img.alt = p.name;
      img.loading = "lazy";
      img.width = 160;
      img.height = 160;
      imgLink.appendChild(img);
      li.appendChild(imgLink);

      const body = document.createElement("div");
      body.className = "product-body";

      const name = makeLink(p, index, "product-name");
      name.textContent = p.name;
      body.appendChild(name);

      const price = document.createElement("p");
      price.className = "product-price";
      price.textContent = `${p.price.toLocaleString()}円`;
      body.appendChild(price);

      // レビューの有無で高さが変わり、ボタンの位置がカードごとにズレるため常に1行分表示する
      const review = document.createElement("p");
      review.className = "product-review";
      review.textContent =
        p.reviewCount > 0 ? `★${p.reviewRate.toFixed(1)}（${p.reviewCount.toLocaleString()}件）` : "レビューなし";
      body.appendChild(review);

      const store = document.createElement("p");
      store.className = "product-store";
      store.textContent = p.storeIsBestSeller ? `${p.storeName}（ベストストア）` : p.storeName;
      body.appendChild(store);

      const delivery = document.createElement("p");
      delivery.className = "product-delivery";
      delivery.textContent = deliveryLabel(p.deliveryDay);
      body.appendChild(delivery);

      const cta = makeLink(p, index, "btn btn-primary product-cta");
      cta.textContent = "Yahoo!ショッピングで納期を確認 →";
      body.appendChild(cta);

      li.appendChild(body);
      return li;
    }

    // 40件ずつ表示し、末尾までスクロールしたら次の40件を追加する(IntersectionObserver)。
    let pendingProducts = [];
    let renderedCount = 0;

    const scrollObserver = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) renderNextBatch();
    });

    function renderNextBatch() {
      const next = pendingProducts.slice(renderedCount, renderedCount + PAGE_SIZE);
      next.forEach((p, i) => listEl.appendChild(createCard(p, renderedCount + i)));
      renderedCount += next.length;
      if (renderedCount >= pendingProducts.length) {
        scrollObserver.unobserve(sentinelEl);
        sentinelEl.hidden = true;
      } else {
        sentinelEl.hidden = false;
      }
    }

    function renderProducts(products) {
      listEl.innerHTML = "";
      pendingProducts = products;
      renderedCount = 0;
      scrollObserver.unobserve(sentinelEl);
      renderNextBatch();
      if (pendingProducts.length > PAGE_SIZE) scrollObserver.observe(sentinelEl);
    }

    // 連続してload()が呼ばれた場合に、後から返ってきた古いレスポンスが新しい結果を
    // 上書きしないようにするための番号(古いリクエストの結果は無視する)。
    let latestRequestId = 0;

    async function load(params) {
      const requestId = ++latestRequestId;
      setState("loading");
      const query = new URLSearchParams();
      Object.entries(params || {}).forEach(([key, value]) => {
        if (value !== undefined && value !== "") query.set(key, String(value));
      });
      try {
        const res = await fetch(`${apiPath}?${query.toString()}`);
        const data = await res.json();
        if (requestId !== latestRequestId) return;
        if (data.error) {
          setState("error");
          return;
        }
        if (!data.products || data.products.length === 0) {
          setState("empty");
          return;
        }
        renderProducts(data.products);
        setState("list");
      } catch {
        if (requestId !== latestRequestId) return;
        setState("error");
      }
    }

    document.addEventListener("commerce:filter-init", (event) => {
      if (event.detail?.slug !== slug) return;
      load(event.detail.params);
    });
    document.addEventListener("commerce:filter-change", (event) => {
      if (event.detail?.slug !== slug) return;
      load(event.detail.params);
    });
  })();
</script>

<!-- 商品カードは document.createElement でクライアントJSから動的生成するため、
     Astroの既定のコンポーネントスコープCSS(data-astro-cid-*が必要)は当たらない。
     is:global にして、動的生成した要素にもスタイルが効くようにする。 -->
<style is:global>
  .commerce-grid {
    margin: 1.5rem 0;
  }
  .state {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .product-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  /* display:gridの指定がhidden属性の既定表示(display:none)を上書きしてしまうため明示する */
  .product-list[hidden] {
    display: none;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .product-image-link {
    display: block;
  }
  .product-card img {
    width: 100%;
    height: 160px;
    object-fit: contain;
    background: var(--color-bg-soft);
  }
  .product-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem 1.1rem;
    flex: 1;
  }
  .product-name {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
    /* レビュー行と同様、名前が1行しかなくても常に2行分の高さを確保し、
       カードごとにボタンの縦位置がズレないようにする */
    min-height: calc(1.4em * 2);
    margin: 0;
    color: var(--color-text);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-name:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }
  .product-price {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }
  .product-review,
  .product-store {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .product-delivery {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-urgent-text);
    margin: 0.15rem 0 0;
  }
  .product-cta {
    margin-top: auto;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    height: auto;
    min-height: 44px;
    white-space: normal;
    line-height: 1.3;
    text-align: center;
    padding: 0.55rem 0.75rem;
  }
  .scroll-sentinel {
    height: 1px;
  }

  @media (max-width: 720px) {
    .product-list {
      grid-template-columns: 1fr;
    }
  }
</style>
