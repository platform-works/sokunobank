---
// テレビ購入コンシェルジュ本体(診断・詳細検索・比較)。マークアップの骨組みだけをサーバーで出力し、
// 中身は lib/commerce/tv/client.ts がブラウザで組み立てる(商品は /api/tv/products/ から取得)。
// JSが動かない環境でも、見出しと「Yahoo!ショッピングで探す」の案内は読めるようにしている。
interface Props {
  apiPath: string;
}
const { apiPath } = Astro.props;
---

<div data-tv-root data-api-path={apiPath}>
  <p class="tv-loading" data-tv-loading>商品情報を取得しています…</p>
  <p class="tv-notice" data-tv-notice role="status" hidden></p>

  <section id="tv-diagnosis" class="tv-panel" aria-labelledby="tv-diagnosis-h">
    <h2 id="tv-diagnosis-h">無料でテレビ診断(5つの質問)</h2>
    <p class="tv-panel-lead">用途・予算・サイズ・ブランド・機能から、条件に合うテレビを最大3台提案します。商品名・説明に記載のない仕様は「未確認」と表示し、必須の条件を満たすと確認できないテレビは提案しません。</p>
    <div data-tv-wizard>
      <noscript><p>診断にはJavaScriptが必要です。<a href="https://shopping.yahoo.co.jp/search/%E6%B6%B2%E6%99%B6%E3%83%86%E3%83%AC%E3%83%93/0/?astk=2" rel="sponsored noopener">Yahoo!ショッピングでテレビを探す</a></p></noscript>
    </div>
  </section>

  <section id="tv-search" class="tv-panel" aria-labelledby="tv-search-h">
    <h2 id="tv-search-h">条件からテレビを探す</h2>
    <p class="tv-panel-lead">サイズ・価格帯・ブランド・解像度・機能で絞り込めます。機能は、商品名・説明に記載を確認できた商品だけが対象です(記載のない商品は、非対応ではなく「未確認」です)。</p>
    <div class="tv-search-layout">
      <details class="tv-filter-box" open>
        <summary>条件を絞り込む</summary>
        <div data-tv-filters></div>
      </details>
      <div class="tv-search-main">
        <div class="tv-search-bar">
          <p data-tv-results-meta aria-live="polite"></p>
          <label for="tv-sort">並び順</label>
          <select id="tv-sort" data-tv-sort>
            <option value="recommended">おすすめ順</option>
            <option value="priceAsc">価格が安い順</option>
            <option value="priceDesc">価格が高い順</option>
            <option value="reviewCount">レビュー件数順</option>
          </select>
        </div>
        <div data-tv-results></div>
      </div>
    </div>
  </section>

  <section id="tv-compare" class="tv-panel" data-tv-compare-panel hidden aria-labelledby="tv-compare-h">
    <h2 id="tv-compare-h">テレビの比較</h2>
    <div data-tv-compare></div>
  </section>

  <div class="tv-tray" data-tv-tray hidden></div>
</div>

<script>
  import { initTvConcierge } from "../../../lib/commerce/tv/client";
  initTvConcierge();
</script>

<style is:global>
  [data-tv-root] {
    --tv-gap: 1rem;
  }
  .tv-loading,
  .tv-notice {
    margin: 1rem 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .tv-notice {
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--color-urgent-soft);
    color: var(--color-urgent-text);
  }
  .tv-panel {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    scroll-margin-top: 4.5rem;
  }
  .tv-panel h2 {
    margin: 0 0 0.4rem;
  }
  .tv-panel-lead,
  .tv-note,
  .tv-q-hint {
    font-size: 0.86rem;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0.9rem;
  }
  .tv-progress-text {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--color-accent-dark);
  }
  .tv-progress-bar {
    height: 8px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    overflow: hidden;
  }
  .tv-progress-bar span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }
  .tv-answer-chips {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tv-chip {
    min-height: 44px;
    padding: 0 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-soft);
    color: var(--color-text);
    font-size: 0.82rem;
    cursor: pointer;
  }
  .tv-chip::after {
    content: " ✎";
    color: var(--color-text-muted);
  }
  .tv-q-title {
    margin: 1.1rem 0 0.2rem;
    font-size: 1.15rem;
  }
  .tv-options {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 0.6rem;
    margin-top: 0.6rem;
  }
  .tv-option {
    min-height: 52px;
    padding: 0.5rem 0.9rem;
    text-align: left;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  .tv-option:hover {
    border-color: var(--color-accent);
  }
  .tv-option.is-selected {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
  }
  .tv-wizard-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .tv-size-helper {
    margin-top: 1rem;
    padding: 0.9rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
  }
  .tv-size-helper h4 {
    margin: 0 0 0.3rem;
  }
  .tv-size-helper input {
    display: block;
    width: 8rem;
    min-height: 44px;
    margin: 0.3rem 0;
    padding: 0 0.6rem;
    font-size: 1rem;
  }
  .tv-size-out {
    font-weight: 600;
    margin: 0.3rem 0 0;
  }
  .tv-conditions {
    margin: 1rem 0;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
  }
  .tv-conditions h4,
  .tv-why h4,
  .tv-caution h4 {
    margin: 0 0 0.3rem;
    font-size: 0.92rem;
  }
  .tv-conditions ul,
  .tv-why ul,
  .tv-caution ul {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.88rem;
  }
  .tv-zero,
  .tv-error {
    padding: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
  }
  .tv-relax {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  /* 商品カード */
  .tv-card-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: var(--tv-gap);
  }
  .tv-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    position: relative;
  }
  .tv-pick-badge {
    grid-column: 1 / -1;
    margin: 0;
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--color-accent-dark);
  }
  .tv-card-image {
    display: block;
  }
  .tv-card-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: #fff;
  }
  .tv-card-body p {
    margin: 0 0 0.3rem;
  }
  .tv-card-maker {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-dark);
  }
  .tv-card-name {
    font-weight: 600;
    line-height: 1.5;
    word-break: break-word;
  }
  .tv-card-model,
  .tv-card-store {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .tv-card-price strong {
    font-size: 1.35rem;
  }
  .tv-card-price small {
    margin-left: 0.4rem;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .tv-specs-wrap {
    margin: 0.5rem 0;
  }
  .tv-specs-wrap summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.86rem;
  }
  .tv-specs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.35rem 1rem;
    margin: 0;
  }
  .tv-spec {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
  }
  .tv-spec dt {
    flex: 0 0 7.2em;
    color: var(--color-text-muted);
  }
  .tv-spec dd {
    margin: 0;
    font-weight: 600;
  }
  .tv-spec.is-unknown dd {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .tv-why,
  .tv-caution {
    margin: 0.6rem 0;
  }
  .tv-caution {
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--color-urgent-soft);
  }
  .tv-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.7rem;
  }
  .tv-compare-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.88rem;
  }
  .tv-compare-toggle input,
  .tv-check input {
    width: 20px;
    height: 20px;
  }
  /* 詳細検索 */
  .tv-search-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .tv-filter-box > summary {
    display: none;
  }
  .tv-fgroup {
    border: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .tv-fgroup legend {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
  }
  .tv-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .tv-fgroup select {
    min-height: 44px;
    width: 100%;
  }
  .tv-sr {
    position: absolute;
    left: -9999px;
  }
  .tv-search-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .tv-search-bar p {
    margin: 0 auto 0 0;
    font-weight: 600;
  }
  .tv-search-bar select {
    min-height: 44px;
  }
  .tv-more {
    margin-top: 1rem;
    text-align: center;
  }
  /* 比較トレー・比較表 */
  .tv-tray {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    background: var(--color-bg);
    border-top: 2px solid var(--color-accent);
    box-shadow: 0 -2px 8px rgba(16, 36, 62, 0.12);
  }
  .tv-tray[hidden] {
    display: none;
  }
  .tv-tray-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    flex: 1 1 auto;
  }
  .tv-tray-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding-left: 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-soft);
    font-size: 0.8rem;
  }
  .tv-tray-remove,
  .tv-tray-clear {
    min-width: 44px;
    min-height: 44px;
    border: none;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .tv-compare-scroll {
    overflow-x: auto;
  }
  .tv-compare-table {
    border-collapse: collapse;
    min-width: 560px;
    width: 100%;
    font-size: 0.86rem;
  }
  .tv-compare-table th,
  .tv-compare-table td {
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--color-border);
    vertical-align: top;
    text-align: left;
  }
  .tv-compare-table tbody th {
    position: sticky;
    left: 0;
    background: var(--color-bg-soft);
    min-width: 7.5em;
    z-index: 1;
  }
  .tv-compare-table thead th {
    background: var(--color-bg-soft);
    min-width: 170px;
  }
  .tv-compare-table .tv-cmp-corner {
    position: sticky;
    left: 0;
    z-index: 2;
  }
  .tv-compare-table .is-diff td {
    background: var(--color-accent-soft);
  }
  .tv-compare-table .is-unknown {
    color: var(--color-text-muted);
  }
  .tv-compare-table img {
    display: block;
    margin-bottom: 0.3rem;
    background: #fff;
  }
  .tv-cmp-name {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
    word-break: break-all;
  }
  .tv-cmp-cta {
    font-size: 0.8rem;
    padding: 0 0.6rem;
  }
  @media (max-width: 720px) {
    .tv-panel {
      padding: 1rem 0.85rem;
    }
    .tv-card {
      grid-template-columns: 1fr;
    }
    .tv-card-image {
      max-width: 220px;
      margin: 0 auto;
    }
    .tv-search-layout {
      grid-template-columns: 1fr;
    }
    .tv-filter-box > summary {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      border: 1px solid var(--color-accent);
      border-radius: var(--radius-md);
      background: var(--color-accent-soft);
      color: var(--color-accent-dark);
      font-weight: 700;
      cursor: pointer;
      margin-bottom: 0.7rem;
    }
    .tv-options {
      grid-template-columns: 1fr;
    }
    .tv-card-actions .btn {
      width: 100%;
    }
    .tv-tray .btn {
      flex: 1 1 100%;
    }
  }
</style>
