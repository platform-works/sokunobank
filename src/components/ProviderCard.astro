---
import type { ComparisonField, Provider } from "../data/schema";

interface Props {
  provider: Provider;
  /** カードの先頭に強調表示する比較項目(通常は最も重要な項目、DMなら「最短発送スピード」) */
  highlightField?: ComparisonField;
}
const { provider, highlightField } = Astro.props;
const link = provider.affiliateUrl || provider.officialUrl;

const highlightValue = highlightField ? provider.values[highlightField.key] : undefined;
const highlightText =
  highlightValue === null || highlightValue === undefined ? undefined : String(highlightValue);
const isUrgentText = (v?: string) => !!v && /(当日|即日)/.test(v);
---

<div class="card provider-card">
  <div class="card-head">
    <h3>
      {provider.name}
      {provider.isPrimary && <span class="badge">メイン</span>}
    </h3>
    {
      highlightText && (
        <p class="highlight-row">
          <span class="highlight-label">{highlightField?.label}</span>
          {isUrgentText(highlightText) ? (
            <span class="badge-urgent">{highlightText}</span>
          ) : (
            <span class="highlight-value">{highlightText}</span>
          )}
        </p>
      )
    }
  </div>

  {provider.description && <p class="description">{provider.description}</p>}

  <div class="card-actions">
    {
      link ? (
        <a
          class="btn btn-primary"
          href={link}
          rel={provider.affiliateUrl ? "sponsored noopener" : "noopener"}
          target="_blank"
        >
          公式サイトを見る
        </a>
      ) : (
        <span class="btn btn-disabled" aria-disabled="true">
          公式サイトURL:準備中
        </span>
      )
    }
  </div>

  {provider.sourceNote && <p class="note">{provider.sourceNote}</p>}
</div>

<style>
  .provider-card {
    margin: 1rem 0;
  }
  .card-head h3 {
    margin: 0 0 0.5rem;
  }
  .highlight-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
  }
  .highlight-label {
    color: var(--color-text-muted);
  }
  .highlight-value {
    font-weight: 700;
  }
  .description {
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .card-actions {
    margin-bottom: 0.5rem;
  }
  .note {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin: 0.6rem 0 0;
  }
</style>
