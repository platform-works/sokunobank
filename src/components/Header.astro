---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;

const navLinks = [
  { label: "サービスを探す", href: "/#search" },
  { label: "カテゴリー", href: "/categories/" },
  { label: "比較記事", href: "/#guides" },
  { label: "SOKUNOBANKについて", href: "/#about" },
  { label: "運営者情報", href: "/about/" },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <img src="/images/header-logo.webp" alt="SOKUNOBANK" height="40" />
      <span class="brand-sub">即納バンク</span>
    </a>

    <nav class="nav-desktop" aria-label="サイト内ナビゲーション">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-cta" href="/lp/original-print/" data-promo="upt-original-print" data-placement="header">
      <span class="header-cta-full">Tシャツ・グッズを作る</span>
      <span class="header-cta-short">Tシャツ作成</span>
      <span class="header-cta-pr" aria-label="広告">PR</span>
    </a>

    <details class="nav-mobile">
      <summary aria-label="メニューを開く">
        <span class="menu-icon" aria-hidden="true"></span>
        メニュー
      </summary>
      <nav aria-label="サイト内ナビゲーション(モバイル)">
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Up-T LPへの導線(ヘッダー・記事内・トップバナー・フッター)の共通クリック計測。
  // 既存の計測関数(Layout.astro)を使い、遷移には干渉しない。値は固定ID。
  document.addEventListener("click", (e) => {
    const w = window as unknown as { sokunobankTrackEvent?: (n: string, p: Record<string, unknown>) => void };
    const target = e.target as Element | null;
    const el = target?.closest<HTMLElement>("[data-promo]");
    try {
      if (el) {
        w.sokunobankTrackEvent?.("promo_click", { promo: el.dataset.promo, placement: el.dataset.placement });
        return;
      }
      // A8広告ボタン(UptAdButton)のクリック。LPは専用ハンドラー(回答つき)で計測するため除外する
      if (document.documentElement.dataset.uptLp) return;
      const ad = target?.closest<HTMLElement>("[data-upt-ad]");
      if (ad && target?.closest("a")) {
        w.sokunobankTrackEvent?.("upt_ad_click", {
          ad_id: ad.dataset.uptAd,
          ad_type: ad.dataset.adType,
          ad_position: ad.dataset.adPosition,
        });
      }
    } catch {
      // no-op
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .brand img {
    height: 40px;
    width: auto;
    display: block;
  }
  .brand-sub {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
    line-height: 1;
    padding-bottom: 0.9rem;
  }

  @media (max-width: 420px) {
    .brand-sub {
      display: none;
    }
  }

  .nav-desktop ul {
    list-style: none;
    display: flex;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    height: 64px;
  }
  .nav-desktop li {
    display: flex;
    align-items: center;
  }
  .nav-desktop a {
    display: flex;
    align-items: center;
    height: 44px;
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav-desktop a:hover {
    color: var(--color-accent-dark);
  }

  .nav-mobile {
    display: none;
  }

  /* 常時表示のCTA(ヘッダーはスクロールしても追従する)。広告LPへの導線のためPRを併記する */
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-dark);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex: none;
  }
  .header-cta:hover {
    filter: brightness(0.92);
  }
  .header-cta:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }
  .header-cta-short {
    display: none;
  }
  .header-cta-pr {
    padding: 0 0.3rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: var(--radius-sm);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .header-cta {
      margin-left: auto;
      margin-right: 0.5rem;
      padding: 0 0.6rem;
      font-size: 0.8rem;
    }
    .header-cta-full {
      display: none;
    }
    .header-cta-short {
      display: inline;
    }
    .nav-desktop {
      display: none;
    }
    .nav-mobile {
      display: block;
      position: relative;
    }
    .nav-mobile summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text);
      padding: 0.5rem 0.25rem;
      min-height: 44px;
    }
    .nav-mobile summary::-webkit-details-marker {
      display: none;
    }
    .menu-icon {
      display: inline-block;
      width: 20px;
      height: 2px;
      background: var(--color-text);
      position: relative;
    }
    .menu-icon::before,
    .menu-icon::after {
      content: "";
      position: absolute;
      left: 0;
      width: 20px;
      height: 2px;
      background: var(--color-text);
    }
    .menu-icon::before {
      top: -6px;
    }
    .menu-icon::after {
      top: 6px;
    }
    .nav-mobile nav {
      position: absolute;
      right: 0;
      top: calc(100% + 0.5rem);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      padding: 0.5rem;
      min-width: 220px;
    }
    .nav-mobile ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav-mobile a {
      display: block;
      padding: 0.7rem 0.75rem;
      color: var(--color-text);
      text-decoration: none;
      font-size: 0.92rem;
      border-radius: var(--radius-sm);
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    .nav-mobile a:hover {
      background: var(--color-bg-soft);
    }
  }
</style>
