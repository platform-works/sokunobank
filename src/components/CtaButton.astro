---
interface Props {
  label: string;
  href?: string;
  sponsored?: boolean;
}
const { label, href, sponsored } = Astro.props;
---

{
  href ? (
    <a
      class="cta-button"
      href={href}
      target="_blank"
      rel={sponsored ? "sponsored noopener" : "noopener"}
    >
      {label}
    </a>
  ) : (
    <span class="cta-button disabled" aria-disabled="true">
      {label}(リンク準備中)
    </span>
  )
}

<style>
  .cta-button {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    border-radius: 0.5rem;
    font-size: 1.05rem;
  }
  .cta-button.disabled {
    background: var(--color-muted);
    cursor: not-allowed;
  }
</style>
