---
interface Props {
  label: string;
  href?: string;
  sponsored?: boolean;
}
const { label, href, sponsored } = Astro.props;
---

{
  href ? (
    <a
      class="btn btn-primary btn-lg"
      href={href}
      target="_blank"
      rel={sponsored ? "sponsored noopener" : "noopener"}
    >
      {label}
    </a>
  ) : (
    <span class="btn btn-disabled btn-lg" aria-disabled="true">
      {label}(リンク準備中)
    </span>
  )
}
