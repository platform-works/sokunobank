---
import type { NavLink } from "../data/site-nav";

interface Props {
  keywords: NavLink[];
}
const { keywords } = Astro.props;

const features = [
  {
    label: "複数社を横断比較",
    icon: "M4 4h9v9H4zM11 11h9v9h-9z",
  },
  {
    label: "最短納期を明示",
    icon: "clock",
  },
  {
    label: "要確認情報は明示",
    icon: "check",
  },
];
---

<section class="search-hero" id="search">
  <div class="container">
    <h1><span class="line">急ぎの発注先、</span><span class="line accent">すぐ見つかる。</span></h1>
    <p class="lead">
      マーケティング・総務・人事担当者向け。DM・印刷・販促物などの即納サービスを、納期・価格・対応条件から比較できます。
    </p>

    <form class="search-form" action="/categories/" method="get">
      <label class="visually-hidden" for="search-input">商品・サービス名を入力してください</label>
      <input
        id="search-input"
        type="text"
        name="q"
        placeholder="商品・サービス名を入力してください(例:DM発送、チラシ)"
        autocomplete="off"
      />
      <button type="submit" class="btn btn-primary btn-lg">検索</button>
    </form>

    <ul class="keywords">
      {
        keywords.map((k) => (
          <li>
            {k.href ? (
              <a class="chip" href={k.href}>
                {k.label}
              </a>
            ) : (
              <span class="chip is-disabled">{k.label}</span>
            )}
          </li>
        ))
      }
    </ul>

    <ul class="feature-strip">
      {
        features.map((f) => (
          <li>
            <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              {f.icon === "clock" && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3.5 2" stroke-linecap="round" stroke-linejoin="round" />
                </>
              )}
              {f.icon === "check" && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M8 12.5l2.5 2.5L16 9.5" stroke-linecap="round" stroke-linejoin="round" />
                </>
              )}
              {f.icon !== "clock" && f.icon !== "check" && (
                <path d={f.icon} stroke-linecap="round" stroke-linejoin="round" />
              )}
            </svg>
            <span>{f.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .search-hero {
    padding-block: 2.75rem 2rem;
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, var(--color-bg) 100%);
  }

  /* PCのみトップバナー画像を背景表示。左側は文字が読めるよう白グラデーションでフェードさせる */
  @media (min-width: 900px) {
    .search-hero {
      min-height: 460px;
      display: flex;
      align-items: center;
      background-image:
        linear-gradient(90deg, rgba(255, 255, 255, 0.97) 0%, rgba(255, 255, 255, 0.9) 32%, rgba(255, 255, 255, 0.35) 58%, rgba(255, 255, 255, 0) 75%),
        url("/images/hero-banner.webp");
      background-size: cover, cover;
      background-position: center, right center;
      background-repeat: no-repeat, no-repeat;
    }
    .search-hero .container {
      width: 100%;
    }
  }

  .search-hero h1 {
    max-width: 720px;
    margin-bottom: 0.75rem;
  }
  .search-hero h1 .line {
    display: block;
  }
  .search-hero h1 .line.accent {
    color: var(--color-accent-dark);
  }

  .lead {
    max-width: 640px;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    margin-bottom: 1.75rem;
  }

  .search-form {
    display: flex;
    gap: 0.6rem;
    max-width: 620px;
    margin-bottom: 1.1rem;
  }
  .search-form input {
    flex: 1;
    height: 48px;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    font-size: 0.95rem;
  }

  .keywords {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 2rem;
    padding: 0;
  }

  .feature-strip {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-border);
  }
  .feature-strip li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
  }
  .feature-icon {
    width: 22px;
    height: 22px;
    color: var(--color-accent-vivid);
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .search-form {
      flex-direction: column;
    }
    .search-form input {
      /* flex-direction: columnで主軸が縦になると、flex:1のflex-basis:0%がheight指定より
         優先され入力欄が文字の最小高さまで潰れてしまうため、flex-growを止めてheightを効かせる */
      flex: none;
    }
    .search-form .btn {
      width: 100%;
    }
  }
</style>
