---
// トップページ用の大型プロモーション(Up-T オリジナルプリントLPへの導線)。
// 広告LPへのリンクのため「PR」を明示する。リンク先はサイト内LP(/lp/original-print/)。
// 画像は LP 用に生成済みのWebP/AVIF(scripts/build-lp-images.mjs)を再利用する。
const base = "/images/lp/original-print/up-t-hero";
---

<section class="upt-promo" aria-labelledby="upt-promo-h">
  <div class="container">
    <a class="upt-promo-link" href="/lp/original-print/" data-promo="upt-original-print">
      <picture class="upt-promo-pic">
        <source type="image/avif" srcset={`${base}-960.avif 960w, ${base}-1672.avif 1672w`} sizes="(min-width: 1200px) 1200px, 100vw" />
        <source type="image/webp" srcset={`${base}-960.webp 960w, ${base}-1672.webp 1672w`} sizes="(min-width: 1200px) 1200px, 100vw" />
        <img src={`${base}-960.webp`} width="1672" height="941" alt="" decoding="async" />
      </picture>
      <span class="upt-promo-body">
        <span class="upt-promo-pr"><span class="pr">PR</span>広告</span>
        <span class="upt-promo-title" id="upt-promo-h">オリジナルTシャツ、<em>急ぎでも簡単発注。</em></span>
        <span class="upt-promo-text">デザインデータがあっても、なくても。必要な枚数と使用日から発注方法をチェック。</span>
        <span class="btn btn-primary btn-lg upt-promo-cta">Tシャツ・グッズの発注方法を見る<span aria-hidden="true"> →</span></span>
      </span>
    </a>
  </div>
</section>

<style>
  .upt-promo {
    padding: 1.25rem 0 0.5rem;
  }
  .upt-promo-link {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(110deg, #ffffff 0%, var(--color-bg-soft-2) 100%);
    color: var(--color-text);
    text-decoration: none;
  }
  .upt-promo-link:hover {
    border-color: var(--color-accent);
  }
  .upt-promo-link:focus-visible {
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
  }
  .upt-promo-pic {
    display: block;
  }
  .upt-promo-pic img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .upt-promo-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
  }
  .upt-promo-pr {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .upt-promo-pr .pr {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .upt-promo-title {
    font-size: clamp(1.5rem, 6vw, 2rem);
    font-weight: 700;
    line-height: 1.3;
  }
  .upt-promo-title em {
    font-style: normal;
    color: var(--color-accent-dark);
    display: inline-block;
  }
  .upt-promo-text {
    font-size: 0.95rem;
    color: var(--color-text);
  }
  .upt-promo-cta {
    margin-top: 0.25rem;
    justify-content: center;
    text-align: center;
    white-space: normal;
    line-height: 1.4;
    height: auto;
    min-height: 48px;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
  @media (min-width: 900px) {
    .upt-promo-link {
      min-height: 340px;
    }
    .upt-promo-pic {
      position: absolute;
      inset: 0 0 0 auto;
      width: 62%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
    }
    .upt-promo-pic img {
      height: 100%;
      aspect-ratio: auto;
    }
    .upt-promo-body {
      position: relative;
      max-width: 52%;
      padding: 2rem 2.25rem;
      gap: 0.75rem;
    }
    .upt-promo-title {
      font-size: clamp(2rem, 3.4vw, 2.8rem);
    }
    .upt-promo-text {
      font-size: 1.05rem;
    }
    .upt-promo-cta {
      align-self: flex-start;
    }
  }
</style>

<script>
  // クリック計測: 既存の計測関数(Layout.astro)を使う。値は固定ID。遷移には干渉しない
  document.querySelectorAll<HTMLElement>("[data-promo]").forEach((el) => {
    el.addEventListener("click", () => {
      const w = window as unknown as { sokunobankTrackEvent?: (n: string, p: Record<string, unknown>) => void };
      try {
        w.sokunobankTrackEvent?.("promo_click", { promo: el.dataset.promo, placement: "home_top" });
      } catch {
        // no-op
      }
    });
  });
</script>
