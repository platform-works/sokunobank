---
interface Props {
  name: string;
  href?: string;
  speedLabel?: string;
  speedValue?: string;
  minQuantityValue?: string;
  providerCount?: number;
  ctaLabel?: string;
}
const {
  name,
  href,
  speedLabel = "最短",
  speedValue,
  minQuantityValue,
  providerCount,
  // hrefがあり比較用の実データ(speedValue)がまだ無いカード(読み物コンテンツへのリンク等)は
  // 「比較する」という文言が実態と合わないため、ctaLabelを明示的に渡して上書きできるようにしている。
  ctaLabel = href ? `${name}を比較 →` : "比較する",
} = Astro.props;

const isUrgentText = (v?: string) => !!v && /(当日|即日|翌日)/.test(v);
---

<div class:list={["category-card", { "is-upcoming": !href }]}>
  <span class="icon-badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 7l9-4 9 4-9 4-9-4z" />
      <path d="M3 7v10l9 4 9-4V7" />
      <path d="M12 11v10" />
    </svg>
  </span>
  <h3>{name}</h3>

  {
    speedValue ? (
      <p class="stat-row">
        <span class="stat-label">{speedLabel}</span>
        <span class:list={["stat-value", { urgent: isUrgentText(speedValue) }]} title={speedValue}>{speedValue}</span>
      </p>
    ) : !href ? (
      <p class="stat-row">
        <span class="badge-soon">準備中</span>
      </p>
    ) : null
  }

  {
    speedValue && speedValue.length > 45 && <p class="stat-more">※納期の全文は詳細ページで確認できます</p>
  }

  {
    minQuantityValue && (
      <p class="stat-row secondary">
        <span class="stat-label">対応</span>
        <span class="stat-value-sm" title={minQuantityValue}>{minQuantityValue}</span>
      </p>
    )
  }

  {
    typeof providerCount === "number" && providerCount > 0 && (
      <p class="stat-row secondary">
        <span class="stat-label">比較サービス</span>
        <span class="stat-value-sm">{providerCount}社</span>
      </p>
    )
  }

  {
    href ? (
      <a class="btn btn-secondary card-cta" href={href}>
        {ctaLabel}
      </a>
    ) : (
      <span class="btn btn-disabled card-cta" aria-disabled="true">
        {ctaLabel}
      </span>
    )
  }
</div>

<style>
  .category-card {
    position: relative;
    transition: border-color 0.15s, background-color 0.15s, box-shadow 0.15s;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.35rem;
    height: 100%;
  }
  .category-card:not(.is-upcoming):hover,
  .category-card:not(.is-upcoming):focus-within {
    border-color: var(--color-accent-vivid);
    background: var(--color-bg-soft);
    box-shadow: 0 4px 14px rgba(16, 36, 62, 0.1);
  }
  .category-card.is-upcoming {
    background: var(--color-bg-soft);
  }
  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent-vivid);
    margin-bottom: 0.75rem;
  }
  .icon-badge svg {
    width: 18px;
    height: 18px;
  }
  .category-card.is-upcoming .icon-badge {
    background: var(--color-bg-soft-2);
    color: var(--color-text-muted);
  }
  .category-card h3 {
    margin: 0 0 0.6rem;
  }
  .stat-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
  }
  .stat-row.secondary {
    font-size: 0.82rem;
  }
  /* 長い納期説明は3行までに丸める(全文は title 属性と詳細ページで確認できる) */
  .stat-value,
  .stat-value-sm {
    min-width: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .stat-more {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .stat-label {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .stat-value {
    font-weight: 700;
  }
  .stat-value.urgent {
    color: var(--color-urgent-text);
    background: var(--color-urgent-soft);
    border: 1px solid var(--color-urgent);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    font-size: 0.85rem;
  }
  .stat-value-sm {
    font-weight: 600;
    color: var(--color-text);
  }
  /* カード全体をクリック可能にする(リンクの当たり判定をカード全面へ拡張) */
  .card-cta[href]::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .card-cta:focus-visible {
    outline: none;
  }
  .card-cta:focus-visible::after {
    outline: 3px solid var(--color-urgent);
    outline-offset: 2px;
  }
  .card-cta {
    margin-top: auto;
    padding-top: 1rem;
    width: 100%;
  }
</style>
