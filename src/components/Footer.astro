---
interface Props {
  siteName: string;
}
const { siteName } = Astro.props;
const year = new Date().getFullYear();
// 事業用の連絡先(要設定)。個人の本名・普段使いのメールアドレスは記載しない。
const contactEmail = "contact@example.com";
---

<footer class="site-footer">
  <p>
    運営:SOKUNOBANK運営事務局 / お問い合わせ:
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    (要設定:事業用メールアドレスに差し替えること)
  </p>
  <p><a href="/about/">運営者情報</a></p>
  <p>&copy; {year} {siteName}</p>
</footer>

<style>
  .site-footer {
    max-width: 960px;
    margin: 3rem auto 0;
    padding: 1.5rem 1.25rem 3rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .site-footer p {
    margin: 0.3rem 0;
  }
</style>
