---
import type { StatHighlight } from "../data/schema";

interface Props {
  headline: string;
  subheadline?: string;
  statHighlight?: StatHighlight;
}
const { headline, subheadline, statHighlight } = Astro.props;
---

<section class="hero">
  <h1>{headline}</h1>
  {subheadline && <p class="subheadline">{subheadline}</p>}
  {
    statHighlight && (
      <p class="stat">
        <strong>{statHighlight.label}: {statHighlight.value}</strong>
        {statHighlight.source && <span class="source"> ({statHighlight.source})</span>}
      </p>
    )
  }
</section>

<style>
  .hero {
    padding: 1rem 0 0.5rem;
  }
  .subheadline {
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    font-size: 1.02rem;
  }
  .stat {
    display: inline-block;
    background: var(--color-accent-soft);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
  }
  .source {
    color: var(--color-text-muted);
    font-weight: 400;
  }
</style>
